# SPDX-License-Identifier: MIT
# @noxforge-version: 21.0.4
# Generated by scripts/generate_design_system.py for NoxForge Obsidian git-delta.
# Include in ~/.gitconfig:
#   [include]
#       path = ~/.config/delta/noxforge.gitconfig

[delta "noxforge"]
    dark = true
    syntax-theme = NoxForgeObsidian
    file-style = bold "#A3FF47"
    file-decoration-style = "#455A64" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#2F414B" box
    hunk-header-line-number-style = bold "#22D3EE"
    line-numbers = true
    line-numbers-left-style = "#748289"
    line-numbers-right-style = "#748289"
    line-numbers-minus-style = "#FF6B7A"
    line-numbers-plus-style = "#A3FF47"
    line-numbers-zero-style = "#748289"
    minus-style = syntax "#2E151B"
    minus-emph-style = syntax "#4A1B24"
    plus-style = syntax "#192D1E"
    plus-emph-style = syntax "#243528"
    zero-style = syntax "#000000"
    blame-palette = "#000000 #0A0F13 #121B21 #1A252C"
