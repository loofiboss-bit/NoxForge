pkgname=noxforge
pkgver=11.0.0
pkgrel=1
pkgdesc='Deep Focus Plasma components for Fedora and Arch KDE'
arch=('x86_64')
url='https://github.com/loofiboss-bit/NoxForge'
license=('MIT')
depends=('breeze-icons' 'kwin' 'plasma-workspace' 'qt6-base')
makedepends=('cmake' 'ninja' 'python' 'qt6-declarative' 'kirigami')
optdepends=('sddm: qualified NoxForge custom login-screen compatibility')
source=('https://github.com/loofiboss-bit/NoxForge/releases/download/v11.0.0/noxforge-11.0.0-source.tar.xz')
sha256sums=('0112d57ebb11699e7610f808e0d51b539de980e46f55034d0b057d59e5ae6984')

build() {
  cmake -S "NoxForge-${pkgver}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
