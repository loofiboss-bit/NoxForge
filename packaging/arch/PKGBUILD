pkgname=noxforge
pkgver=9.0.0
pkgrel=1
pkgdesc='System Coherence Plasma components for Fedora and Arch KDE'
arch=('x86_64')
url='https://github.com/loofiboss-bit/NoxForge'
license=('MIT')
depends=('breeze-icons' 'kwin' 'plasma-workspace' 'qt6-base')
makedepends=('cmake' 'ninja' 'python' 'qt6-declarative' 'kirigami')
optdepends=('sddm: qualified NoxForge custom login-screen compatibility')
source=('https://github.com/loofiboss-bit/NoxForge/releases/download/v9.0.0/noxforge-9.0.0-source.tar.xz')
sha256sums=('fe17ed96d6b7795aad0db291e3840059e0fce319b5402e64ed4065597588b22f')

build() {
  cmake -S "NoxForge-${pkgver}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
