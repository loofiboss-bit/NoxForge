pkgname=noxforge
pkgver=10.1.0
pkgrel=1
pkgdesc='Everyday Precision Plasma components for Fedora and Arch KDE'
arch=('x86_64')
url='https://github.com/loofiboss-bit/NoxForge'
license=('MIT')
depends=('breeze-icons' 'kwin' 'plasma-workspace' 'qt6-base')
makedepends=('cmake' 'ninja' 'python' 'qt6-declarative' 'kirigami')
optdepends=('sddm: qualified NoxForge custom login-screen compatibility')
source=('https://github.com/loofiboss-bit/NoxForge/releases/download/v10.1.0/noxforge-10.1.0-source.tar.xz')
sha256sums=('bb3eddad8b983f51d0a93f415be646028103d374257e2a3347a04ee09658342d')

build() {
  cmake -S "NoxForge-${pkgver}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
