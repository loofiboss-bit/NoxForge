pkgname=noxforge
pkgver=18.0.0
pkgrel=1
pkgdesc='True Obsidian OLED Parity & Dual-Stack Architecture for Fedora and Arch KDE'
arch=('x86_64')
url='https://github.com/loofiboss-bit/NoxForge'
license=('MIT')
depends=('breeze-icons' 'kwin' 'plasma-workspace' 'qt6-base')
makedepends=('cmake' 'ninja' 'python' 'qt6-declarative' 'kirigami')
optdepends=('sddm: qualified NoxForge custom login-screen compatibility')
source=('https://github.com/loofiboss-bit/NoxForge/releases/download/v18.0.0/noxforge-18.0.0-source.tar.xz')
sha256sums=('2bddc5304a873af48e4ec4e0612cd15e0b74e6a2381118d2accc0ad0532ce64d')

build() {
  cmake -S "NoxForge-${pkgver}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
