{
  "schemaVersion": 2,
  "surfaces": {
    "sddm": "sddm/NoxForge/Main.qml",
    "splash": "look-and-feel/io.github.loofiboss.noxforge.desktop/contents/splash/Splash.qml",
    "logout": "look-and-feel/io.github.loofiboss.noxforge.desktop/contents/logout/Logout.qml",
    "tabbox": "kwin/tabbox/io.github.loofiboss.noxforge.desktop/contents/ui/Switcher.qml"
  },
  "compositions": [
    {
      "width": 1280,
      "height": 720,
      "scenario": "long-rtl",
      "covers": [
        "long-text",
        "localization",
        "rtl",
        "stable-status"
      ]
    },
    {
      "width": 1920,
      "height": 1080,
      "scenario": "keyboard",
      "covers": [
        "keyboard-only",
        "focus"
      ]
    },
    {
      "width": 2560,
      "height": 1440,
      "scenario": "standard",
      "covers": [
        "default-state",
        "session-contracts"
      ]
    },
    {
      "width": 3440,
      "height": 1440,
      "scenario": "empty-reduced",
      "covers": [
        "empty-text",
        "reduced-motion",
        "ultrawide"
      ]
    }
  ],
  "requiredCoverage": [
    "long-text",
    "empty-text",
    "localization",
    "keyboard-only",
    "rtl",
    "reduced-motion",
    "stable-status",
    "session-contracts"
  ],
  "v6ResolutionMatrix": [
    {"width": 1280, "height": 720},
    {"width": 1920, "height": 1080},
    {"width": 2560, "height": 1440},
    {"width": 3440, "height": 1440}
  ],
  "v6ScenarioMatrix": {
    "sddm": ["standard", "long-rtl", "keyboard", "error", "busy", "reduced"],
    "splash": ["standard", "reduced"],
    "logout": ["standard", "long-rtl", "keyboard", "reduced"],
    "tabbox": ["standard", "long-rtl", "keyboard", "empty", "many", "reduced"]
  },
  "choreographyFrames": [
    {"name": "start", "progress": 0.0},
    {"name": "mid", "progress": 0.5},
    {"name": "end", "progress": 1.0}
  ],
  "v6EvidencePolicy": {
    "kind": "authentic-offscreen-qml",
    "testProgressProductionDefault": -1,
    "qualifiesLiveSession": false,
    "liveInteractionRemainsPhase7": true
  },
  "sddmContracts": [
    "login",
    "session",
    "keyboard-layout",
    "suspend",
    "reboot",
    "power-off"
  ],
  "logoutContracts": [
    "lock",
    "logout",
    "suspend",
    "reboot",
    "power-off",
    "cancel",
    "update"
  ],
  "privateLockScreen": false
}
