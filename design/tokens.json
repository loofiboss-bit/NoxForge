      "foreground": "textPrimary",
      "border": "border"
    },
    "surface": {
      "background": "surface",
      "foreground": "textPrimary",
      "border": "border"
    },
    "control": {
      "background": "surfaceRaised",
      "foreground": "textPrimary",
      "border": "border"
    },
    "controlHover": {
