    "noneMs": 0,
    "pressMs": 90,
    "hoverMs": 140,
    "popupMs": 180,
    "busyMs": 180,
    "reducedMotion": {
      "durationMs": 0,
      "spatialMotion": false,
      "busyIndicatorStatic": true
