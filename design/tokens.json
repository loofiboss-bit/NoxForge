      "background": "surfaceSelected",
      "minimumRatio": 7.0
    },
    {
      "name": "secondary-on-canvas",
      "foreground": "textSecondary",
      "background": "background",
      "minimumRatio": 4.5
    },
    {
      "name": "secondary-on-surface",
      "foreground": "textSecondary",
