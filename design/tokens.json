      "foreground": "textDisabled",
      "border": "border"
    },
    "busy": {
      "background": "surfaceRaised",
      "foreground": "detailCyan",
      "border": "detailCyan"
    },
    "error": {
      "background": "surfaceRaised",
      "foreground": "negative",
      "border": "negative"
    },
    "success": {
      "background": "surfaceRaised",
      "foreground": "accent",
      "border": "borderStrong"
    }
  },
  "opacity": {
    "enabled": 1.0,
    "inactive": 0.72,
    "disabled": 0.55,
    "subtle": 0.12,
    "scrim": 0.72
  },
  "elevation": {
    "flat": {
      "level": 0,
      "shadow": "none"
    },
    "surface": {
      "level": 1,
      "shadow": "none"
    },
    "control": {
      "level": 2,
      "shadow": "control"
    },
    "popup": {
      "level": 3,
      "shadow": "popup"
    }
  },
  "overlay": {
    "none": {
      "color": "background",
      "opacity": 0.0
    },
    "hover": {
      "color": "textPrimary",
      "opacity": 0.04
    },
    "pressed": {
      "color": "background",
      "opacity": 0.16
    },
    "busy": {
      "color": "detailCyan",
      "opacity": 0.12
    },
    "scrim": {
      "color": "background",
      "opacity": 0.72
    }
  },
