    {
      "name": "primary-on-surface",
      "foreground": "textPrimary",
      "background": "surface",
      "minimumRatio": 7.0
    },
    {
      "name": "primary-on-control",
      "foreground": "textPrimary",
      "background": "surfaceRaised",
      "minimumRatio": 7.0
    },
    {
      "name": "primary-on-hover",
      "foreground": "textPrimary",
      "background": "surfaceHover",
      "minimumRatio": 7.0
    },
    {
      "name": "primary-on-selection",
