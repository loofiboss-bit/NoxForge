      "minimumRatio": 4.5
    },
    {
      "name": "disabled-on-control",
      "foreground": "textDisabled",
      "background": "surfaceRaised",
      "minimumRatio": 3.0
    },
    {
      "name": "primary-action",
      "foreground": "accentInk",
      "background": "accent",
      "minimumRatio": 7.0
    },
    {
      "name": "pressed-primary-action",
