        "motion": "noneMs"
      },
      "pressed": {
        "role": "controlPressed",
        "opacity": "enabled",
        "elevation": "flat",
        "overlay": "pressed",
        "indicator": "none",
        "motion": "pressMs"
      },
      "checked": {
        "role": "selection",
        "opacity": "enabled",
        "elevation": "control",
        "overlay": "none",
        "indicator": "checkGlyph",
        "motion": "pressMs"
      },
      "selected": {
        "role": "selection",
        "opacity": "enabled",
        "elevation": "surface",
        "overlay": "none",
        "indicator": "leadingMarker",
        "motion": "hoverMs"
      },
      "disabled": {
        "role": "disabled",
        "opacity": "disabled",
        "elevation": "flat",
        "overlay": "none",
        "indicator": "none",
        "motion": "noneMs"
      },
      "busy": {
        "role": "busy",
        "opacity": "enabled",
        "elevation": "control",
        "overlay": "busy",
        "indicator": "busyGlyph",
        "motion": "busyMs"
      },
      "error": {
        "role": "error",
        "opacity": "enabled",
        "elevation": "control",
        "overlay": "none",
        "indicator": "errorGlyph",
        "motion": "noneMs"
      },
      "success": {
        "role": "success",
        "opacity": "enabled",
        "elevation": "control",
        "overlay": "none",
        "indicator": "successGlyph",
        "motion": "noneMs"
      }
    }
