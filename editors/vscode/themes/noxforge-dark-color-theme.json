  "semanticTokenColors": {
    "namespace": "#A78BFA",
    "type": "#A78BFA",
    "class": "#A78BFA",
    "enum": "#A78BFA",
    "interface": "#22D3EE",
    "struct": "#A78BFA",
    "typeParameter": "#A78BFA",
    "parameter": "#E8F0F2",
    "variable": "#E8F0F2",
    "variable.readonly": "#FBBF24",
    "property": "#E8F0F2",
    "enumMember": "#FBBF24",
    "function": "#E8F0F2",
    "method": "#E8F0F2",
    "macro": "#A3FF47",
    "decorator": "#A78BFA",
    "keyword": {
      "foreground": "#A3FF47",
      "bold": true
    },
    "comment": {
      "foreground": "#748289",
      "italic": true
    },
    "string": "#22D3EE",
    "number": "#FBBF24",
    "operator": "#A6B4B9"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#748289",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#A3FF47",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#22D3EE"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#E8F0F2"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#A78BFA"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#FBBF24"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#A6B4B9"
      }
    },
    {
      "scope": [
        "variable",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#E8F0F2"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#22D3EE"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#A78BFA"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#A3FF47",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF6B7A"
      }
    }
  ]
}
