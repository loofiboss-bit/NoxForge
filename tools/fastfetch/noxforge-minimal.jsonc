{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo_minimal.txt",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  \u001b[38;2;53;72;82m\u276f\u001b[0m  ",
    "color": {
      "keys": "38;2;34;211;238",
      "title": "38;2;163;255;71"
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "38;2;163;255;71",
        "yellow": "38;2;251;191;36",
        "red": "38;2;255;107;122"
      }
    },
    "bar": {
      "char": {
        "elapsed": "\u2588",
        "total": "\u2591"
      },
      "border": {
        "left": " [",
        "right": "]"
      },
      "width": 8
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "\u001b[1;38;2;163;255;71m{user-name}\u001b[0m\u001b[38;2;53;72;82m@\u001b[0m\u001b[1;38;2;34;211;238m{host-name}\u001b[0m  \u001b[38;2;53;72;82m//\u001b[0m  \u001b[1;38;2;167;139;250mNOXFORGE MINI HUD\u001b[0m"
    },
    {
      "type": "os",
      "key": "\udb82\udcdb OS",
      "format": "{pretty-name} {arch}"
    },
    {
      "type": "kernel",
      "key": "\udb81\udc8b Kernel",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "\udb85\udc42 Uptime"
    },
    {
      "type": "de",
      "key": "\udb82\udde8 Desktop",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "wm",
      "key": "\udb84\udcac WM",
      "format": "{pretty-name} ({protocol-name})"
    },
    {
      "type": "cpu",
      "key": "\udb80\udf5b CPU",
      "format": "{name} ({cores-logical})"
    },
    {
      "type": "memory",
      "key": "\udb81\ude1a RAM"
    },
    {
      "type": "disk",
      "key": "\udb80\udeca Disk (/)",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "\udb80\udc82 Battery"
    },
    {
      "type": "custom",
      "format": " \u001b[38;2;163;255;71m\u25cf\u001b[0m \u001b[38;2;34;211;238m\u25cf\u001b[0m \u001b[38;2;167;139;250m\u25cf\u001b[0m \u001b[38;2;251;191;36m\u25cf\u001b[0m \u001b[38;2;255;107;122m\u25cf\u001b[0m"
    }
  ]
}
