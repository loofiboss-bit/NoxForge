{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo_cyber.txt",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  \u001b[38;2;167;139;250m\u276f\u001b[0m  ",
    "color": {
      "keys": "38;2;34;211;238",
      "title": "38;2;163;255;71"
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "38;2;163;255;71",
        "yellow": "38;2;251;191;36",
        "red": "38;2;255;107;122"
      }
    },
    "bar": {
      "char": {
        "elapsed": "\u2588",
        "total": "\u2591"
      },
      "border": {
        "left": " \u001b[38;2;167;139;250m[\u001b[0m",
        "right": "\u001b[38;2;167;139;250m]\u001b[0m"
      },
      "width": 10
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "\u001b[1;38;2;163;255;71m{user-name}\u001b[0m\u001b[38;2;53;72;82m@\u001b[0m\u001b[1;38;2;34;211;238m{host-name}\u001b[0m  \u001b[38;2;53;72;82m//\u001b[0m  \u001b[1;38;2;167;139;250mNOXFORGE 2.0\u001b[0m  \u001b[38;2;53;72;82m//\u001b[0m  \u001b[38;2;166;180;185mCYBER MATRIX\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;167;139;250m\u2500\u2500\u2500 \u001b[1;38;2;163;255;71m\u2726 SYSTEM CORE \u2726 \u001b[0m\u001b[38;2;167;139;250m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m"
    },
    {
      "type": "os",
      "key": "\udb82\udcdb OS",
      "format": "{pretty-name} {arch}"
    },
    {
      "type": "host",
      "key": "\udb80\udf22 Machine",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "\udb81\udc8b Kernel",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "\udb85\udc42 Uptime"
    },
    {
      "type": "packages",
      "key": "\udb80\udfd6 Packages"
    },
    {
      "type": "locale",
      "key": "\uf1ab Locale"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;167;139;250m\u2500\u2500\u2500 \u001b[1;38;2;163;255;71m\u2726 WORKSPACE & DESKTOP \u2726 \u001b[0m\u001b[38;2;167;139;250m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m"
    },
    {
      "type": "de",
