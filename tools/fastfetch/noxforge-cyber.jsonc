    },
    {
      "type": "wm",
      "key": "\udb84\udcac Window Mgr",
      "format": "{pretty-name} ({protocol-name})"
    },
    {
      "type": "theme",
      "key": "\udb81\udd0e Theme",
      "format": "{theme1}"
    },
    {
      "type": "icons",
      "key": "\uefa8 Icons",
      "format": "{icons1}"
    },
    {
      "type": "cursor",
      "key": "\udb80\uddbf Cursor",
      "format": "{theme} ({size}px)"
    },
    {
      "type": "terminal",
      "key": "\ue795 Terminal"
    },
    {
      "type": "shell",
      "key": "\udb81\udfb7 Shell"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;167;139;250m\u2500\u2500\u2500 \u001b[1;38;2;163;255;71m\u2726 HARDWARE MATRIX \u2726 \u001b[0m\u001b[38;2;167;139;250m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "\udb80\udf5b CPU",
      "format": "{name} ({cores-logical}) @ {freq-max}"
    },
    {
      "type": "cpuusage",
      "key": "\udb81\udcc5 CPU Load"
    },
    {
      "type": "gpu",
      "key": "\udb82\udcae GPU",
      "format": "{name} [{type}]"
    },
    {
      "type": "display",
      "key": "\udb80\udf79 Display",
      "format": "{width}x{height} @ {refresh-rate}Hz ({inch}\")"
    },
    {
      "type": "memory",
      "key": "\udb81\ude1a RAM"
    },
    {
      "type": "disk",
      "key": "\udb80\udeca Disk (/)",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "\udb80\udc82 Battery"
    },
    {
      "type": "custom",
      "format": "  \u001b[38;2;163;255;71m\u25cf\u001b[0m \u001b[38;2;34;211;238m\u25cf\u001b[0m \u001b[38;2;167;139;250m\u25cf\u001b[0m \u001b[38;2;251;191;36m\u25cf\u001b[0m \u001b[38;2;255;107;122m\u25cf\u001b[0m \u001b[38;2;166;180;185m\u25cf\u001b[0m \u001b[38;2;53;72;82m\u25cf\u001b[0m \u001b[38;2;232;240;242m\u25cf\u001b[0m"
