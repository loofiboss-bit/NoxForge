def ecosystem_status() -> dict[str, Any]:
    result: dict[str, Any] = {}
    for app_id, app in SUPPORTED_ECOSYSTEM_APPS.items():
        detected = bool(app["detect"]())
        installed = bool(app["check"]())
        result[app_id] = {
            "name": app["name"],
            "description": app["description"],
            "detected": detected,
            "installed": installed,
        }
    return result


def ecosystem_apply(app_names: list[str] | None = None, dry_run: bool = False) -> dict[str, Any]:
    targets = app_names if app_names and "all" not in app_names else list(SUPPORTED_ECOSYSTEM_APPS.keys())
    applied: list[str] = []
    skipped: list[str] = []
    errors: dict[str, str] = {}

    for app_id in targets:
        if app_id not in SUPPORTED_ECOSYSTEM_APPS:
            errors[app_id] = f"Unknown ecosystem application: {app_id}"
            continue
        app = SUPPORTED_ECOSYSTEM_APPS[app_id]
        src = find_asset(app["source_subpath"])
        if not src or not src.exists():
            errors[app_id] = f"Source assets not found: {app['source_subpath']}"
            continue
        target_dir = app["target_dir"]()
        if not target_dir:
            skipped.append(app_id)
            continue
        try:
            if not dry_run:
                target_dir.mkdir(parents=True, exist_ok=True)
                if app_id == "starship":
                    shutil.copy2(src / "starship.toml", target_dir / "starship.toml")
                elif app_id == "fastfetch":
                    shutil.copy2(src / "noxforge.jsonc", target_dir / "config.jsonc")
                elif app_id == "firefox":
                    shutil.copy2(src / "userChrome.css", target_dir / "userChrome.css")
                elif src.is_dir():
                    for item in src.iterdir():
                        if item.is_file():
                            shutil.copy2(item, target_dir / item.name)
                elif src.is_file():
                    shutil.copy2(src, target_dir / src.name)
            applied.append(app_id)
        except Exception as err:
            errors[app_id] = str(err)

    return {
        "status": "applied" if not dry_run else "dry-run",
        "applied": applied,
        "skipped": skipped,
        "errors": errors,
    }


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="noxforge-ctl",
        description="NoxForge Unified Control Hub - Profile, Accent, Opacity, and Health Orchestration.",
    )
    parser.add_argument("-v", "--version", action="version", version=f"noxforge-ctl {VERSION}")
    subparsers = parser.add_subparsers(dest="command", help="Available subcommands")

    # switch
    switch_parser = subparsers.add_parser("switch", help="Switch between Graphite and Obsidian profiles")
    switch_parser.add_argument("profile", choices=["graphite", "obsidian"], help="Target profile")
    switch_parser.add_argument("-n", "--dry-run", action="store_true", help="Simulate without applying")
    switch_parser.add_argument("--json", action="store_true", help="Output result as JSON")

    # apply / setup
    apply_parser = subparsers.add_parser(
        "apply",
        aliases=["setup"],
        help="Apply complete NoxForge setup (Global Theme, styles, icons, Aurorae, wallpaper)",
    )
    apply_parser.add_argument(
        "profile",
        nargs="?",
        choices=["graphite", "obsidian"],
        default=None,
        help="Target profile (graphite or obsidian, defaults to active)",
    )
    apply_parser.add_argument(
        "--layout",
        action="store_true",
        help="Also apply the NoxForge floating panel desktop layout",
    )
    apply_parser.add_argument("-n", "--dry-run", action="store_true", help="Simulate without applying")
    apply_parser.add_argument("--json", action="store_true", help="Output result as JSON")

    # sync
    sync_parser = subparsers.add_parser("sync", help="Synchronize entire desktop (Plasma, GTK, icons, cursors, styles)")
    sync_parser.add_argument("--profile", choices=["graphite", "obsidian"], help="Target profile to synchronize (defaults to active profile)")
    sync_parser.add_argument("-n", "--dry-run", action="store_true", help="Simulate without applying")
    sync_parser.add_argument("--json", action="store_true", help="Output result as JSON")

    # accent
    accent_parser = subparsers.add_parser("accent", help="Select active Forge accent color or custom WCAG AA hex")
    accent_parser.add_argument(
        "color",
        help="Accent color (lime, cyan, violet, amber, system, custom, or #RRGGBB)",
    )
    accent_parser.add_argument(
        "custom_hex",
        nargs="?",
        default=None,
        help="Hex color for custom accent (e.g. '#A3FF47')",
    )
    accent_parser.add_argument("-n", "--dry-run", action="store_true", help="Simulate without applying")
    accent_parser.add_argument("--json", action="store_true", help="Output result as JSON")

    # status
    status_parser = subparsers.add_parser("status", help="Display current NoxForge desktop status")
    status_parser.add_argument("--json", action="store_true", help="Output status in JSON")

    # opacity (delegates to noxforge-opacity)
    opacity_parser = subparsers.add_parser("opacity", help="Configure transparency and depth (noxforge-opacity)")
    opacity_parser.add_argument("opacity_args", nargs=argparse.REMAINDER, help="Arguments passed to noxforge-opacity")

    # doctor (delegates to noxforge-doctor)
    doctor_parser = subparsers.add_parser("doctor", help="Inspect installation health and diagnostics")
    doctor_parser.add_argument("doctor_args", nargs=argparse.REMAINDER, help="Arguments passed to noxforge-doctor")

    # schedule (day/night automation)
    sched_parser = subparsers.add_parser("schedule", help="Manage automated Day/Night profile switching")
    sched_group = sched_parser.add_mutually_exclusive_group(required=True)
    sched_group.add_argument("--enable", action="store_true", help="Enable automatic Day/Night schedule timer")
    sched_group.add_argument("--disable", action="store_true", help="Disable automatic Day/Night timer")
    sched_group.add_argument("--status", action="store_true", help="Check schedule timer status")
    sched_parser.add_argument("--day-time", default="07:00", help="Day transition time (HH:MM, default: 07:00)")
    sched_parser.add_argument("--night-time", default="20:00", help="Night transition time (HH:MM, default: 20:00)")
    sched_parser.add_argument("--json", action="store_true", help="Output schedule status in JSON")

    # ecosystem
    eco_parser = subparsers.add_parser("ecosystem", help="Opt-in theme synchronization for developer ecosystem and apps")
    eco_sub = eco_parser.add_subparsers(dest="eco_command", help="Ecosystem action")

    eco_status = eco_sub.add_parser("status", help="List ecosystem apps and detection/installation status")
    eco_status.add_argument("--json", action="store_true", help="Output status as JSON")

    eco_apply = eco_sub.add_parser("apply", help="Deploy themes to ecosystem applications")
    eco_apply.add_argument("apps", nargs="*", default=["all"], help="Target app names (e.g. zed, btop, discord, firefox, starship, fastfetch, vscode, helix, neovim, ghostty, kitty, alacritty, foot, or 'all')")
    eco_apply.add_argument("-n", "--dry-run", action="store_true", help="Simulate without copying files")
    eco_apply.add_argument("--json", action="store_true", help="Output result as JSON")

    # gui
    gui_parser = subparsers.add_parser("gui", help="Launch the NoxForge Control Center GUI")

    args = parser.parse_args()

    if not args.command:
        # Default behavior with no arguments: show status
        status = get_current_status()
        print(f"NoxForge Control Hub v{VERSION}")
        print(f"  Active Profile: {status['profile'].upper()}")
        print(f"  Color Scheme:   {status['colorScheme']}")
        print(f"  Plasma Style:   {status['plasmaStyle']}")
        print(f"  Aurorae Deco:   {status['aurorae']}")
        print(f"  KWin TabBox:    {status['kwinTabBox']}")
        print(f"  Accent Color:   {status['accent']} ({status['accentRgb'] or 'default'})")
        print("\nQuick Start:")
        print("  noxforge-ctl apply graphite     Apply complete Graphite setup (theme, icons, wallpaper)")
        print("  noxforge-ctl apply obsidian     Apply complete Obsidian OLED setup")
        print("  noxforge-ctl gui                Launch interactive Control Center GUI")
        print("\nRun 'noxforge-ctl --help' for commands, or 'noxforge-ctl gui' to launch Control Center.")
        return 0

    if args.command in ("apply", "setup"):
        result = apply_setup(profile=args.profile, apply_layout=getattr(args, "layout", False), dry_run=args.dry_run)
        if args.json:
            print(json.dumps(result, indent=2))
        else:
            print(f"[NoxForge] Complete setup applied: {result['changes']['profile'].upper()}" + (" (dry-run)" if args.dry_run else ""))
            for k, v in result["changes"].items():
                print(f"  {k}: {v}")
            print("\nSetup complete! Enjoy your unified NoxForge desktop.")
            print("Tip: In Dolphin, press Ctrl+M to hide classic menubar for the clean modern look.")
        return 0

    if args.command == "switch":
        result = switch_profile(args.profile, dry_run=args.dry_run)
        if args.json:
            print(json.dumps(result, indent=2))
        else:
            print(f"[NoxForge] Profile set to: {args.profile.upper()}" + (" (dry-run)" if args.dry_run else ""))
            for k, v in result["changes"].items():
                print(f"  {k}: {v}")
        return 0

    if args.command == "sync":
        result = sync_desktop(profile=args.profile, dry_run=args.dry_run)
        if args.json:
            print(json.dumps(result, indent=2))
        else:
            print(f"[NoxForge] Desktop synchronized to: {result['changes']['profile'].upper()}" + (" (dry-run)" if args.dry_run else ""))
            for k, v in result["changes"].items():
                print(f"  {k}: {v}")
        return 0

    if args.command == "accent":
        try:
            result = set_accent(args.color, custom_hex=args.custom_hex, dry_run=args.dry_run)
        except ValueError as err:
            if args.json:
                print(json.dumps({"status": "error", "message": str(err)}, indent=2), file=sys.stderr)
            else:
                print(f"[NoxForge Error] {err}", file=sys.stderr)
            return 1
        if args.json:
            print(json.dumps(result, indent=2))
        else:
            print(f"[NoxForge] Accent color set to: {result['accent'].upper()}" + (f" ({result.get('hex', '')})" if result.get('hex') else ""))
            if "contrastGraphite" in result:
                print(f"  WCAG AA Contrast: Graphite {result['contrastGraphite']}:1, Obsidian {result['contrastObsidian']}:1")
        return 0

    if args.command == "status":
        status = get_current_status()
        if args.json:
            print(json.dumps(status, indent=2))
        else:
            for k, v in status.items():
                print(f"{k}: {v}")
        return 0

    if args.command == "schedule":
        action = "enable" if args.enable else ("disable" if args.disable else "status")
        try:
            res = manage_schedule(action, day_time=args.day_time, night_time=args.night_time)
        except ValueError as err:
            if args.json:
                print(json.dumps({"status": "error", "message": str(err)}, indent=2), file=sys.stderr)
            else:
                print(f"[NoxForge Error] {err}", file=sys.stderr)
            return 1
        if args.json:
            print(json.dumps(res, indent=2))
        else:
            print(f"[NoxForge Schedule] {action}: {res}")
        return 0

    if args.command == "ecosystem":
        if getattr(args, "eco_command", None) == "apply":
            res = ecosystem_apply(app_names=args.apps, dry_run=args.dry_run)
            if args.json:
                print(json.dumps(res, indent=2))
            else:
                print(f"[NoxForge Ecosystem] Status: {res['status']}")
                if res["applied"]:
                    print(f"  Applied: {', '.join(res['applied'])}")
                if res["skipped"]:
                    print(f"  Skipped (not detected/configured): {', '.join(res['skipped'])}")
                if res["errors"]:
                    print("  Errors:")
                    for app, err in res["errors"].items():
                        print(f"    {app}: {err}")
            return 0
        else:
            status = ecosystem_status()
            if getattr(args, "json", False):
                print(json.dumps(status, indent=2))
            else:
                print("NoxForge Ecosystem Applications:")
                for app_id, info in status.items():
                    det = "✓" if info["detected"] else " "
                    inst = "✓" if info["installed"] else " "
                    print(f"  [{det}] [{inst}] {app_id:<12} {info['name']:<25} - {info['description']}")
                print("\nLegend: [Detected] [Theme Installed]")
                print("Run 'noxforge-ctl ecosystem apply [apps...]' to deploy themes.")
            return 0

    if args.command == "opacity":
        candidates = [
            ROOT / "tools/noxforge-opacity",
            Path(shutil.which("noxforge-opacity") or "/usr/bin/noxforge-opacity"),
            Path("/usr/bin/noxforge-opacity"),
            Path.home() / ".local/bin/noxforge-opacity",
        ]
        tool_opacity = next((p for p in candidates if p.is_file()), None)
        if not tool_opacity:
            print("Error: noxforge-opacity executable not found", file=sys.stderr)
            return 1
        sub_args = args.opacity_args or []
        res = subprocess.run([sys.executable, str(tool_opacity)] + sub_args)
        return res.returncode

    if args.command == "doctor":
        candidates = [
            ROOT / "tools/noxforge-doctor",
            Path(shutil.which("noxforge-doctor") or "/usr/bin/noxforge-doctor"),
            Path("/usr/bin/noxforge-doctor"),
            Path.home() / ".local/bin/noxforge-doctor",
        ]
        tool_doctor = next((p for p in candidates if p.is_file()), None)
        if not tool_doctor:
            print("Error: noxforge-doctor executable not found", file=sys.stderr)
            return 1
        sub_args = args.doctor_args or []
        res = subprocess.run([sys.executable, str(tool_doctor)] + sub_args)
        return res.returncode

    if args.command == "gui":
        gui_candidates = [
            ROOT / "tools/control_center.py",
            Path("/usr/share/noxforge/control_center.py"),
            Path.home() / ".local/share/noxforge/control_center.py",
            Path(__file__).resolve().parent / "control_center.py",
            ROOT / "tools/opacity_gui.py",
            Path("/usr/share/noxforge/opacity_gui.py"),
        ]
        gui_script = next((p for p in gui_candidates if p.is_file()), None)
        if not gui_script:
            print("Error: NoxForge Control Center GUI script not found", file=sys.stderr)
            return 1
        os.execv(sys.executable, [sys.executable, str(gui_script)])

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
