def notify_plasma_kwin() -> None:
    """Notify KWin window decorations safely without triggering SIGSEGV or shell teardown."""
    qdbus = shutil.which("qdbus-qt6") or shutil.which("qdbus6") or shutil.which("qdbus")
    if qdbus:
        run_cmd([qdbus, "org.kde.KWin", "/KWin", "reconfigure"])
    elif shutil.which("dbus-send"):
        run_cmd(["dbus-send", "--session", "--type=method_call", "--dest=org.kde.KWin", "/KWin", "org.kde.KWin.reconfigure"])


def get_active_accent_hex() -> str:
    """Return the active accent hex color from kdeglobals or default Electric Lime."""
    accent_rgb = read_kconfig("kdeglobals", "General", "AccentColor", "").strip()
    if accent_rgb:
        parts = [p.strip() for p in accent_rgb.split(",")]
        if len(parts) == 3 and all(p.isdigit() for p in parts):
            r, g, b = (max(0, min(255, int(p))) for p in parts)
            return f"#{r:02X}{g:02X}{b:02X}"
    return ACCENT_COLORS["lime"]


def find_gtk_theme_css(gtk_theme: str, gtk_dir: str) -> Path | None:
    """Locate the installed or repository GTK CSS base file for @import chaining."""
    data_home = get_xdg_data_home()
    candidates = [
        data_home / "themes" / gtk_theme / gtk_dir / "gtk.css",
        Path("/usr/share/themes") / gtk_theme / gtk_dir / "gtk.css",
        ROOT / "themes" / gtk_theme / gtk_dir / "gtk.css",
    ]
    for candidate in candidates:
        if candidate.is_file():
            return candidate.resolve()
    return None


def sync_gtk_config(
    profile: str | None = None,
    accent_hex: str | None = None,
    dry_run: bool = False,
) -> list[str]:
    """Maintain non-destructive @import + @define-color chain in ~/.config/gtk-{3,4}.0/gtk.css."""
    config_dir = get_kde_config_dir()
    active_profile = (profile or "").strip().lower()
    if active_profile not in ("graphite", "obsidian"):
        status = get_current_status()
        active_profile = "obsidian" if status.get("profile") == "obsidian" else "graphite"

    is_obsidian = active_profile == "obsidian"
    gtk_theme = "NoxForgeObsidian" if is_obsidian else "NoxForge"
    effective_hex = accent_hex if accent_hex is not None else get_active_accent_hex()

    modified: list[str] = []
    for gtk_dir in ("gtk-3.0", "gtk-4.0"):
        css_file = config_dir / gtk_dir / "gtk.css"
        existing = css_file.read_text(encoding="utf-8") if css_file.is_file() else ""
        lines = [
            line
            for line in existing.splitlines()
            if not line.startswith("/* NoxForge Dynamic Accent")
            and not line.startswith("/* END NoxForge Dynamic Accent")
            and "@define-color accent_" not in line
            and "@define-color theme_selected_bg_color" not in line
            and "@define-color theme_view_active" not in line
            and not (line.strip().startswith("@import url(") and "NoxForge" in line)
        ]

        base_css_path = find_gtk_theme_css(gtk_theme, gtk_dir)
        block_lines: list[str] = []
        if base_css_path or effective_hex:
            block_lines.append("/* NoxForge Dynamic Accent & Libadwaita Chain */")
            if base_css_path:
                block_lines.append(f'@import url("file://{base_css_path.as_posix()}");')
            if effective_hex:
                pal = resolve_accent_palette(effective_hex, is_obsidian=is_obsidian)
                block_lines.extend(
                    [
                        f"@define-color accent_color {pal['accent']};",
                        f"@define-color accent_bg_color {pal['accent']};",
                        f"@define-color accent_fg_color {pal['accentInk']};",
                        f"@define-color accent_pressed_color {pal['accentPressed']};",
                        f"@define-color theme_selected_bg_color {pal['accent']};",
                        f"@define-color theme_view_active {pal['surfaceSelected']};",
                    ]
                )
            block_lines.append("/* END NoxForge Dynamic Accent */")

        cleaned = "\n".join(lines).strip()
        if block_lines:
            new_text = (cleaned + "\n\n" + "\n".join(block_lines) + "\n") if cleaned else ("\n".join(block_lines) + "\n")
        else:
            new_text = (cleaned + "\n") if cleaned else ""

        if not dry_run:
            css_file.parent.mkdir(parents=True, exist_ok=True)
            css_file.write_text(new_text, encoding="utf-8")
        modified.append(str(css_file))
    return modified


def sync_gtk_accent(hex_color: str, dry_run: bool = False) -> list[str]:
    """Backwards-compatible entry point delegating to sync_gtk_config."""
    return sync_gtk_config(profile=None, accent_hex=hex_color, dry_run=dry_run)


def sync_konsole_profile(profile: str, dry_run: bool = False) -> str:
    """Synchronize Konsole default profile and colorscheme with active NoxForge surface."""
    is_obsidian = profile.strip().lower() == "obsidian"
    scheme_name = "NoxForgeObsidian" if is_obsidian else "NoxForgeDark"
    prof_filename = "NoxForgeObsidian.profile" if is_obsidian else "NoxForge.profile"
    prof_display = "NoxForge Obsidian" if is_obsidian else "NoxForge"

    if not dry_run:
        konsole_dir = get_xdg_data_home() / "konsole"
        konsole_dir.mkdir(parents=True, exist_ok=True)
        prof_path = konsole_dir / prof_filename
        prof_content = (
            "[Appearance]\n"
            f"ColorScheme={scheme_name}\n\n"
            "[General]\n"
            f"Name={prof_display}\n"
            "Parent=FALLBACK/\n"
        )
        prof_path.write_text(prof_content, encoding="utf-8")
        write_kconfig("konsolerc", "Desktop Entry", "DefaultProfile", prof_filename)
    return prof_filename


def switch_profile(profile: str, dry_run: bool = False) -> dict[str, Any]:
    target = profile.lower().strip()
    if target not in ("graphite", "obsidian"):
        raise ValueError(f"Unknown profile: {profile}. Must be 'graphite' or 'obsidian'.")

    is_obsidian = target == "obsidian"
    theme_id = THEME_OBSIDIAN_ID if is_obsidian else THEME_GRAPHITE_ID
    color_scheme = "NoxForgeObsidian" if is_obsidian else "NoxForgeDark"
    aurorae_theme = f"__aurorae__svg__{theme_id}"
    tabbox_layout = theme_id
    gtk_theme = "NoxForgeObsidian" if is_obsidian else "NoxForge"
    konsole_profile = sync_konsole_profile(target, dry_run=dry_run)
    gtk_synced = sync_gtk_config(profile=target, accent_hex=None, dry_run=dry_run)

    changes: dict[str, Any] = {
        "profile": target,
        "colorScheme": color_scheme,
        "plasmaStyle": theme_id,
        "auroraeTheme": aurorae_theme,
        "kwinTabBox": tabbox_layout,
        "splashTheme": theme_id,
        "gtkTheme": gtk_theme,
        "konsoleProfile": konsole_profile,
        "gtkSynced": gtk_synced,
    }

    if dry_run:
        return {"status": "dry-run", "changes": changes}

    # Apply KDE Settings
    write_kconfig("kdeglobals", "General", "ColorScheme", color_scheme)
    write_kconfig("plasmarc", "Theme", "name", theme_id)
    write_kconfig("kwinrc", "org.kde.kdecoration2", "theme", aurorae_theme)
    write_kconfig("kwinrc", "TabBox", "LayoutName", tabbox_layout)
    write_kconfig("ksplashrc", "KSplash", "Theme", theme_id)

    # Apply GTK 3 & 4 user settings
    for gtk_dir in ("gtk-3.0", "gtk-4.0"):
        try:
            write_kconfig(f"{gtk_dir}/settings.ini", "Settings", "gtk-theme-name", gtk_theme)
        except Exception:
            pass

    # Plasma live CLI appliers (gentle and safe)
    if shutil.which("plasma-apply-colorscheme"):
        run_cmd(["plasma-apply-colorscheme", color_scheme])
    if shutil.which("plasma-apply-desktoptheme"):
        run_cmd(["plasma-apply-desktoptheme", theme_id])

    # Auto-sync any tracked ecosystem apps
    eco_synced = sync_tracked_ecosystem(profile=target, accent_hex=None, dry_run=False)
    if eco_synced:
        changes["ecosystemSynced"] = eco_synced

    notify_plasma_kwin()
    return {"status": "applied", "changes": changes}


def sync_desktop(profile: str | None = None, dry_run: bool = False) -> dict[str, Any]:
    """Perform complete synchronization of all NoxForge desktop layers."""
    target = (profile or "").lower().strip()
    if not target:
        status = get_current_status()
        target = status.get("profile", "graphite")
    if target not in ("graphite", "obsidian"):
        target = "graphite"

    is_obsidian = target == "obsidian"
    theme_id = THEME_OBSIDIAN_ID if is_obsidian else THEME_GRAPHITE_ID
    color_scheme = "NoxForgeObsidian" if is_obsidian else "NoxForgeDark"
    aurorae_theme = f"__aurorae__svg__{theme_id}"
    tabbox_layout = theme_id
    gtk_theme = "NoxForgeObsidian" if is_obsidian else "NoxForge"
    konsole_profile = sync_konsole_profile(target, dry_run=dry_run)
    gtk_synced = sync_gtk_config(profile=target, accent_hex=None, dry_run=dry_run)

    changes: dict[str, Any] = {
        "profile": target,
        "colorScheme": color_scheme,
        "plasmaStyle": theme_id,
        "widgetStyle": "NoxForge",
        "auroraeTheme": aurorae_theme,
        "kwinTabBox": tabbox_layout,
        "cursorTheme": "NoxForge-Cursors",
        "iconTheme": "NoxForge",
        "soundTheme": "NoxForge",
        "splashTheme": theme_id,
        "gtkTheme": gtk_theme,
        "konsoleProfile": konsole_profile,
        "gtkSynced": gtk_synced,
    }

    if dry_run:
        return {"status": "dry-run", "changes": changes}

    # KDE Configuration files
    write_kconfig("kdeglobals", "General", "ColorScheme", color_scheme)
    write_kconfig("kdeglobals", "KDE", "widgetStyle", "NoxForge")
    write_kconfig("kdeglobals", "Icons", "Theme", "NoxForge")
    write_kconfig("kdeglobals", "Sounds", "Theme", "NoxForge")
    write_kconfig("kcminputrc", "Mouse", "cursorTheme", "NoxForge-Cursors")
    write_kconfig("kdeglobals", "Mouse", "cursorTheme", "NoxForge-Cursors")
    write_kconfig("plasmarc", "Theme", "name", theme_id)
    write_kconfig("kwinrc", "org.kde.kdecoration2", "library", "org.kde.kwin.aurorae")
    write_kconfig("kwinrc", "org.kde.kdecoration2", "theme", aurorae_theme)
    write_kconfig("kwinrc", "TabBox", "LayoutName", tabbox_layout)
    write_kconfig("ksplashrc", "KSplash", "Theme", theme_id)

    # GTK 3 & 4 settings
    for gtk_dir in ("gtk-3.0", "gtk-4.0"):
        try:
            write_kconfig(f"{gtk_dir}/settings.ini", "Settings", "gtk-theme-name", gtk_theme)
            write_kconfig(f"{gtk_dir}/settings.ini", "Settings", "gtk-icon-theme-name", "NoxForge")
        except Exception:
            pass

    # Plasma live CLI appliers (gentle and safe)
    if shutil.which("plasma-apply-colorscheme"):
        run_cmd(["plasma-apply-colorscheme", color_scheme])
    if shutil.which("plasma-apply-desktoptheme"):
        run_cmd(["plasma-apply-desktoptheme", theme_id])
    if shutil.which("plasma-apply-cursortheme"):
        run_cmd(["plasma-apply-cursortheme", "NoxForge-Cursors"])

    eco_synced = sync_tracked_ecosystem(profile=target, accent_hex=None, dry_run=False)
    if eco_synced:
        changes["ecosystemSynced"] = eco_synced

    notify_plasma_kwin()
    return {"status": "applied", "changes": changes}


def find_wallpaper_image(wallpaper_name: str) -> Path | None:
    """Locate the wallpaper image file in repo, system, or user directory."""
    candidates = [
        ROOT / f"wallpapers/{wallpaper_name}/contents/images/2560x1440.png",
        ROOT / f"wallpapers/{wallpaper_name}/contents/images/1920x1080.png",
        Path(f"/usr/share/wallpapers/{wallpaper_name}/contents/images/2560x1440.png"),
        Path(f"/usr/share/wallpapers/{wallpaper_name}/contents/images/1920x1080.png"),
        Path.home() / f".local/share/wallpapers/{wallpaper_name}/contents/images/2560x1440.png",
        Path.home() / f".local/share/wallpapers/{wallpaper_name}/contents/images/1920x1080.png",
    ]
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    return None


def apply_setup(profile: str | None = None, apply_layout: bool = False, dry_run: bool = False) -> dict[str, Any]:
    """Apply complete NoxForge setup: Global Theme, styles, icons, Aurorae, wallpaper, and optional desktop layout."""
    target = (profile or "").lower().strip()
    if not target:
        status = get_current_status()
        target = status.get("profile", "graphite")
    if target not in ("graphite", "obsidian"):
        target = "graphite"

    is_obsidian = target == "obsidian"
    theme_id = THEME_OBSIDIAN_ID if is_obsidian else THEME_GRAPHITE_ID
    wallpaper_name = "NoxForge-Obsidian" if is_obsidian else "NoxForge"

    sync_res = sync_desktop(profile=target, dry_run=dry_run)
    changes = dict(sync_res.get("changes", {}))
    changes["wallpaper"] = wallpaper_name
    changes["globalTheme"] = theme_id
    if apply_layout:
        changes["desktopLayout"] = "floating-panel"

    if dry_run:
        return {"status": "dry-run", "changes": changes}

    if shutil.which("plasma-apply-lookandfeel"):
        cmd = ["plasma-apply-lookandfeel", "-a", theme_id]
        if apply_layout:
            cmd.append("--resetLayout")
        run_cmd(cmd)

    wp_path = find_wallpaper_image(wallpaper_name)
    if wp_path and shutil.which("plasma-apply-wallpaperimage"):
        run_cmd(["plasma-apply-wallpaperimage", str(wp_path)])

    notify_plasma_kwin()
    return {"status": "applied", "changes": changes}


def set_accent(accent: str, custom_hex: str | None = None, dry_run: bool = False) -> dict[str, Any]:
    target = accent.strip()
    hex_color = ""
    contrast_info: dict[str, float] = {}

    if target.lower() == "custom":
        if not custom_hex:
            raise ValueError("Missing custom hex color. Usage: noxforge-ctl accent custom '#RRGGBB'")
        c_g, c_o = validate_custom_accent_contrast(custom_hex)
        target = "custom"
        hex_color = custom_hex.upper()
        contrast_info = {"contrastGraphite": round(c_g, 2), "contrastObsidian": round(c_o, 2)}
    elif target.startswith("#"):
        c_g, c_o = validate_custom_accent_contrast(target)
        hex_color = target.upper()
        target = "custom"
        contrast_info = {"contrastGraphite": round(c_g, 2), "contrastObsidian": round(c_o, 2)}
    elif target.lower() in ACCENT_COLORS:
        target = target.lower()
        hex_color = ACCENT_COLORS[target]
    elif target.lower() == "system":
        target = "system"
        hex_color = ""
    else:
        raise ValueError(f"Unknown accent: {accent}. Must be one of: lime, cyan, violet, amber, system, custom, or '#RRGGBB'.")

    if dry_run:
        res: dict[str, Any] = {"status": "dry-run", "accent": target, "hex": hex_color}
        if contrast_info:
            res.update(contrast_info)
        res["gtkSynced"] = sync_gtk_accent(hex_color, dry_run=True)
        return res

    if target == "system":
        delete_kconfig("kdeglobals", "General", "AccentColor")
        delete_kconfig("kdeglobals", "General", "accentColorFromWallpaper")
    else:
        r = int(hex_color[1:3], 16)
        g = int(hex_color[3:5], 16)
        b = int(hex_color[5:7], 16)
        rgb_str = f"{r},{g},{b}"
        write_kconfig("kdeglobals", "General", "AccentColor", rgb_str)
        write_kconfig("kdeglobals", "General", "accentColorFromWallpaper", "false")

    gtk_synced = sync_gtk_accent(hex_color, dry_run=False)

    active_scheme = read_kconfig("kdeglobals", "General", "ColorScheme", "NoxForgeDark")
    if shutil.which("plasma-apply-colorscheme"):
        run_cmd(["plasma-apply-colorscheme", active_scheme])

    eco_synced = sync_tracked_ecosystem(profile=None, accent_hex=hex_color or ACCENT_COLORS["lime"], dry_run=False)

    notify_plasma_kwin()
    res = {"status": "applied", "accent": target, "hex": hex_color, "gtkSynced": gtk_synced}
    if eco_synced:
        res["ecosystemSynced"] = eco_synced
    if contrast_info:
        res.update(contrast_info)
    return res


def get_current_status() -> dict[str, Any]:
    scheme = read_kconfig("kdeglobals", "General", "ColorScheme", "unknown")
    plasma_style = read_kconfig("plasmarc", "Theme", "name", "unknown")
    aurorae = read_kconfig("kwinrc", "org.kde.kdecoration2", "theme", "unknown")
    tabbox = read_kconfig("kwinrc", "TabBox", "LayoutName", "unknown")
    accent_rgb = read_kconfig("kdeglobals", "General", "AccentColor", "")

    is_obsidian = "obsidian" in scheme.lower() or "obsidian" in plasma_style.lower()
    profile = "obsidian" if is_obsidian else ("graphite" if "noxforge" in scheme.lower() else "custom")

    accent_name = "custom"
    accent_hex = ACCENT_COLORS["lime"]
    if accent_rgb:
        parts = [p.strip() for p in accent_rgb.split(",")]
        if len(parts) == 3 and all(p.isdigit() for p in parts):
            r, g, b = (max(0, min(255, int(p))) for p in parts)
            accent_hex = f"#{r:02X}{g:02X}{b:02X}"
        for name, hex_code in ACCENT_COLORS.items():
            r = int(hex_code[1:3], 16)
            g = int(hex_code[3:5], 16)
            b = int(hex_code[5:7], 16)
            if accent_rgb.strip() == f"{r},{g},{b}":
                accent_name = name
                accent_hex = hex_code
                break
    elif not accent_rgb:
        accent_name = "default"

    return {
        "version": VERSION,
        "profile": profile,
        "colorScheme": scheme,
        "plasmaStyle": plasma_style,
        "aurorae": aurorae,
        "kwinTabBox": tabbox,
        "accent": accent_name,
        "accentRgb": accent_rgb,
        "accentHex": accent_hex,
    }


def manage_flatpak(action: str = "status", dry_run: bool = False) -> dict[str, Any]:
    """Configure or inspect user Flatpak overrides for GTK 3/4 and Libadwaita themes."""
    override_file = get_xdg_data_home() / "flatpak/overrides/global"
    required_tokens = ("xdg-data/themes:ro", "xdg-config/gtk-3.0:ro", "xdg-config/gtk-4.0:ro")

    if action == "status":
        if not override_file.is_file():
            return {"status": "absent", "enabled": False, "path": str(override_file)}
        try:
            text = override_file.read_text(encoding="utf-8", errors="ignore")
            has_themes = "xdg-data/themes" in text
            has_gtk = "xdg-config/gtk-3.0" in text and "xdg-config/gtk-4.0" in text
            return {
                "status": "configured" if (has_themes and has_gtk) else ("partial" if has_themes else "not-configured"),
                "enabled": bool(has_themes and has_gtk),
                "path": str(override_file),
            }
        except OSError:
            return {"status": "unreadable", "enabled": False, "path": str(override_file)}

    if action == "enable":
        if not dry_run:
            override_file.parent.mkdir(parents=True, exist_ok=True)
            parser = noxforge_core.configparser.ConfigParser(interpolation=None, strict=False)
            parser.optionxform = str  # type: ignore[assignment]
            if override_file.is_file():
                try:
                    parser.read(override_file, encoding="utf-8")
                except Exception:
                    pass
            if not parser.has_section("Context"):
                parser.add_section("Context")
            existing_fs = parser.get("Context", "filesystems", fallback="")
            items = [item.strip() for item in existing_fs.split(";") if item.strip()]
            for req in required_tokens:
                base_req = req.split(":")[0]
                if not any(it.startswith(base_req) for it in items):
                    items.append(req)
            parser.set("Context", "filesystems", ";".join(items) + ";")
            with override_file.open("w", encoding="utf-8") as handle:
                parser.write(handle, space_around_delimiters=False)
        return {
            "status": "enabled" if not dry_run else "dry-run",
            "enabled": True,
            "path": str(override_file),
            "filesystems": list(required_tokens),
        }

    if action == "disable":
        if not dry_run and override_file.is_file():
            parser = noxforge_core.configparser.ConfigParser(interpolation=None, strict=False)
            parser.optionxform = str  # type: ignore[assignment]
            try:
                parser.read(override_file, encoding="utf-8")
                if parser.has_section("Context") and parser.has_option("Context", "filesystems"):
                    existing_fs = parser.get("Context", "filesystems", fallback="")
                    prefixes = tuple(t.split(":")[0] for t in required_tokens)
                    items = [
                        item.strip()
                        for item in existing_fs.split(";")
                        if item.strip() and not item.strip().startswith(prefixes)
                    ]
                    if items:
                        parser.set("Context", "filesystems", ";".join(items) + ";")
                    else:
                        parser.remove_option("Context", "filesystems")
                    with override_file.open("w", encoding="utf-8") as handle:
                        parser.write(handle, space_around_delimiters=False)
            except Exception:
                pass
        return {"status": "disabled" if not dry_run else "dry-run", "enabled": False, "path": str(override_file)}

    raise ValueError(f"Unknown flatpak action: {action!r}")


def manage_schedule(
    action: str,
    day_time: str = "07:00",
    night_time: str = "20:00",
    now_hm: str | None = None,
    dry_run: bool = False,
) -> dict[str, Any]:
    systemd_user = get_kde_config_dir() / "systemd/user"
    service_path = systemd_user / "noxforge-daynight.service"
    timer_path = systemd_user / "noxforge-daynight.timer"
    can_use_systemctl = bool(
        not dry_run
        and shutil.which("systemctl")
        and systemd_user.resolve() == (Path.home() / ".config/systemd/user").resolve()
    )

    if action == "status":
        has_timer = timer_path.is_file()
        is_active = False
        sched_desc = "none"
        parsed_day = day_time
        parsed_night = night_time
        if has_timer:
            try:
                txt = timer_path.read_text(encoding="utf-8")
                times = [line.split()[-1] for line in txt.splitlines() if line.startswith("OnCalendar=")]
                if len(times) >= 2:
                    parsed_day = times[0][:5]
                    parsed_night = times[1][:5]
                    sched_desc = f"{parsed_day} (Graphite) / {parsed_night} (Obsidian)"
                else:
                    sched_desc = "configured"
            except Exception:
                sched_desc = "configured"
        if has_timer and shutil.which("systemctl"):
            res = run_cmd(["systemctl", "--user", "is-active", "noxforge-daynight.timer"])
            is_active = res.stdout.strip() == "active"
        return {
            "scheduled": has_timer,
            "active": is_active,
            "schedule": sched_desc,
            "dayTime": parsed_day,
            "nightTime": parsed_night,
        }

    if action == "disable":
        if can_use_systemctl:
            run_cmd(["systemctl", "--user", "disable", "--now", "noxforge-daynight.timer"])
        if not dry_run:
            if timer_path.exists():
                timer_path.unlink()
            if service_path.exists():
                service_path.unlink()
        return {"status": "disabled" if not dry_run else "dry-run"}

    if action == "apply-now":
        info = manage_schedule("status", day_time=day_time, night_time=night_time)
        eff_day = info.get("dayTime") or day_time
        eff_night = info.get("nightTime") or night_time
        if not now_hm:
            import datetime

            now_hm = datetime.datetime.now().strftime("%H:%M")
        target_profile = noxforge_core.evaluate_schedule_profile(now_hm, eff_day, eff_night)
        switch_res = switch_profile(target_profile, dry_run=dry_run)
        return {
            "status": "applied" if not dry_run else "dry-run",
            "now": now_hm,
            "dayTime": eff_day,
            "nightTime": eff_night,
            "profile": target_profile,
            "changes": switch_res.get("changes", {}),
        }

    if action == "enable":
        time_re = re.compile(r"^([01]\d|2[0-3]):[0-5]\d$")
        if not time_re.match(day_time) or not time_re.match(night_time):
            raise ValueError(f"Invalid time format (expected HH:MM): day={day_time!r}, night={night_time!r}")
        if not dry_run:
            systemd_user.mkdir(parents=True, exist_ok=True)
            ctl_bin = Path(__file__).resolve()
            service_content = f"""[Unit]
Description=NoxForge Day/Night Profile Switcher
After=graphical-session.target

[Service]
Type=oneshot
ExecStart="{sys.executable}" "{ctl_bin}" schedule --apply-now --day-time {day_time} --night-time {night_time}
"""
            service_path.write_text(service_content, encoding="utf-8")

            timer_content = f"""[Unit]
Description=NoxForge Day/Night Transition Timer

[Timer]
OnCalendar=*-*-* {day_time}:00
OnCalendar=*-*-* {night_time}:00
Persistent=true

[Install]
WantedBy=timers.target
"""
            timer_path.write_text(timer_content, encoding="utf-8")

            if can_use_systemctl:
                run_cmd(["systemctl", "--user", "daemon-reload"])
                run_cmd(["systemctl", "--user", "enable", "--now", "noxforge-daynight.timer"])
        return {
            "status": "enabled" if not dry_run else "dry-run",
            "schedule": f"{day_time} (Graphite) / {night_time} (Obsidian)",
            "dayTime": day_time,
            "nightTime": night_time,
        }

    return {"status": "unknown"}


def manage_motion(action: str = "status", dry_run: bool = False) -> dict[str, Any]:
    """Inspect or configure KDE Plasma / NoxForge Reduced Motion policy."""
    act = action.strip().lower()
    if act == "status":
        factor_raw = read_kconfig("kdeglobals", "KDE", "AnimationDurationFactor", "").strip()
        env_override = os.environ.get("NOXFORGE_REDUCED_MOTION", "").strip()
        try:
            factor_val = float(factor_raw) if factor_raw else 1.0
        except ValueError:
            factor_val = 1.0
        is_reduced = factor_val == 0.0 or env_override in ("1", "true", "yes")
        return {
            "status": "ok",
            "mode": "reduced" if is_reduced else "standard",
            "reducedMotion": is_reduced,
            "animationDurationFactor": factor_val,
        }

    if act in ("reduced", "enable"):
        if not dry_run:
            write_kconfig("kdeglobals", "KDE", "AnimationDurationFactor", "0")
            notify_plasma_kwin()
        return {
            "status": "applied" if not dry_run else "dry-run",
            "mode": "reduced",
            "reducedMotion": True,
            "animationDurationFactor": 0.0,
        }

    if act in ("standard", "disable"):
        if not dry_run:
            write_kconfig("kdeglobals", "KDE", "AnimationDurationFactor", "1")
            notify_plasma_kwin()
        return {
            "status": "applied" if not dry_run else "dry-run",
            "mode": "standard",
            "reducedMotion": False,
            "animationDurationFactor": 1.0,
        }

    raise ValueError(f"Unknown motion action: {action!r}. Expected 'status', 'reduced', or 'standard'.")


def _get_preferences_path() -> Path:
    return get_kde_config_dir() / "noxforge/preferences.json"


def _load_preferences() -> dict[str, Any]:
    path = _get_preferences_path()
    if path.is_file():
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
            if isinstance(data, dict):
                return data
        except Exception:
            pass
    return {}


def _save_preferences(prefs: dict[str, Any]) -> None:
    path = _get_preferences_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(prefs, indent=2) + "\n", encoding="utf-8")


def manage_wallpaper(variant: str = "list", dry_run: bool = False) -> dict[str, Any]:
    """List or apply any of the 5 NoxForge wallpaper variants."""
    variants_map = noxforge_core.WALLPAPER_VARIANTS
    prefs = _load_preferences()
    active_key = prefs.get("wallpaperVariant")
    if not active_key:
        status = get_current_status()
        active_key = "obsidian" if status.get("profile") == "obsidian" else "standard"

    clean = (variant or "list").strip()
    if clean.lower() in ("list", "status"):
        available: dict[str, Any] = {}
        for k, meta in variants_map.items():
            img = find_wallpaper_image(meta["id"])
            available[k] = {
                "id": meta["id"],
                "label": meta["label"],
                "profile": meta["profile"],
                "available": img is not None,
                "path": str(img) if img else None,
            }
        return {
            "status": "ok",
            "activeVariant": active_key,
            "activeId": variants_map.get(active_key, variants_map["standard"])["id"],
            "variants": available,
        }

    matched_key = clean.lower() if clean.lower() in variants_map else next(
        (k for k, m in variants_map.items() if m["id"].lower() == clean.lower()),
        None,
    )
    if not matched_key:
        valid = ", ".join(variants_map.keys())
        raise ValueError(f"Unknown wallpaper variant {variant!r}. Choose from: {valid}")

    meta = variants_map[matched_key]
    wp_path = find_wallpaper_image(meta["id"])
    if not dry_run:
        prefs["wallpaperVariant"] = matched_key
        prefs["wallpaperId"] = meta["id"]
        _save_preferences(prefs)
        if wp_path and shutil.which("plasma-apply-wallpaperimage"):
            run_cmd(["plasma-apply-wallpaperimage", str(wp_path)])
    return {
        "status": "applied" if not dry_run else "dry-run",
        "variant": matched_key,
        "wallpaperId": meta["id"],
        "label": meta["label"],
        "path": str(wp_path) if wp_path else None,
    }


def export_preset(file_path: str | None = None) -> dict[str, Any]:
    """Export current NoxForge configuration state as a portable JSON preset."""
    status = get_current_status()
    motion = manage_motion("status")
    flatpak = manage_flatpak("status")
    sched = manage_schedule("status")
    wp = manage_wallpaper("status")
    payload: dict[str, Any] = {
        "schemaVersion": 1,
        "version": VERSION,
        "profile": status.get("profile") if status.get("profile") in ("graphite", "obsidian") else "graphite",
        "accent": status.get("accent", "lime"),
        "accentHex": status.get("accentHex", ACCENT_COLORS["lime"]),
        "reducedMotion": bool(motion.get("reducedMotion", False)),
        "wallpaperVariant": wp.get("activeVariant", "standard"),
        "flatpakEnabled": bool(flatpak.get("enabled", False)),
        "schedule": {
            "enabled": bool(sched.get("scheduled", False)),
            "dayTime": sched.get("dayTime", "07:00"),
            "nightTime": sched.get("nightTime", "20:00"),
        },
    }
    if file_path:
        out = Path(file_path).expanduser()
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    return payload


def import_preset(file_path: str, dry_run: bool = False) -> dict[str, Any]:
    """Import and apply a NoxForge JSON preset file."""
    src = Path(file_path).expanduser()
    if not src.is_file():
        raise FileNotFoundError(f"Preset file not found: {file_path}")
    data = json.loads(src.read_text(encoding="utf-8"))
    if not isinstance(data, dict):
        raise ValueError("Invalid preset JSON structure: expected object.")

    profile = str(data.get("profile", "graphite")).lower()
    if profile not in ("graphite", "obsidian"):
        raise ValueError(f"Invalid profile in preset: {profile!r}")

    accent_hex = str(data.get("accentHex") or ACCENT_COLORS["lime"]).strip()
    accent_key = str(data.get("accent") or "lime").strip().lower()
    if accent_key in ACCENT_COLORS:
        set_accent(accent_key, dry_run=dry_run)
    elif accent_key == "system":
        set_accent("system", dry_run=dry_run)
    else:
        set_accent("custom", custom_hex=accent_hex, dry_run=dry_run)

    switch_profile(profile, dry_run=dry_run)

    reduced = bool(data.get("reducedMotion", False))
    manage_motion("reduced" if reduced else "standard", dry_run=dry_run)

    wp_var = str(data.get("wallpaperVariant") or ("obsidian" if profile == "obsidian" else "standard"))
    if wp_var in noxforge_core.WALLPAPER_VARIANTS:
        manage_wallpaper(wp_var, dry_run=dry_run)

    if "flatpakEnabled" in data:
        manage_flatpak("enable" if data["flatpakEnabled"] else "disable", dry_run=dry_run)

    sched = data.get("schedule")
    if isinstance(sched, dict) and not dry_run:
        if sched.get("enabled"):
            manage_schedule(
                "enable",
                day_time=str(sched.get("dayTime", "07:00")),
                night_time=str(sched.get("nightTime", "20:00")),
            )
        else:
            manage_schedule("disable")

    return {
        "status": "imported" if not dry_run else "dry-run",
        "source": str(src),
        "profile": profile,
        "accentHex": accent_hex,
        "reducedMotion": reduced,
        "wallpaperVariant": wp_var,
    }


def find_asset(rel_path: str) -> Path | None:
    data_home = get_xdg_data_home()
    for base in [ROOT, data_home / "noxforge", Path("/usr/share/noxforge")]:
        candidate = base / rel_path
        if candidate.exists():
            return candidate
    return None


def get_firefox_chrome_dir() -> Path | None:
    for base in (Path.home() / ".mozilla/firefox", Path.home() / ".librewolf"):
        if base.is_dir():
            for p in base.glob("*.default*"):
                if p.is_dir():
                    return p / "chrome"
    return None


