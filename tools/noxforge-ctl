def render_ecosystem_content(raw_text: str, profile: str, accent_hex: str) -> str:
    """Inject active profile surface and accent palette into a deployed ecosystem file."""
    is_obsidian = profile.strip().lower() == "obsidian"
    pal = resolve_accent_palette(accent_hex, is_obsidian=is_obsidian)
    acc = pal["accent"]
    acc_pressed = pal["accentPressed"]
    surf_sel = pal["surfaceSelected"]

    text = raw_text
    if acc.upper() != "#A3FF47":
        text = text.replace("#A3FF47", acc).replace("#a3ff47", acc.lower())
        text = text.replace("A3FF47", acc.lstrip("#")).replace("a3ff47", acc.lstrip("#").lower())
        text = text.replace("#82D936", acc_pressed).replace("#82d936", acc_pressed.lower())
        text = text.replace("#223429", surf_sel).replace("#192D1E", surf_sel)
        r, g, b = noxforge_core.hex_to_rgb_tuple(acc)
        text = text.replace("38;2;163;255;71", f"38;2;{r};{g};{b}")
    return text


def _deploy_tracked_file(
    src_file: Path,
    dst_file: Path,
    profile: str,
    accent_hex: str,
    existing_meta: dict[str, dict[str, Any]] | None = None,
) -> dict[str, Any]:
    """Safely back up existing user file before writing rendered NoxForge content."""
    bak_file = Path(str(dst_file) + BACKUP_SUFFIX)
    dst_key = str(dst_file)
    had_original = False
    if bak_file.is_file():
        had_original = True
    elif existing_meta is not None and dst_key in existing_meta:
        # Target is already managed by NoxForge; preserve original hadOriginal flag without backing up NoxForge output
        had_original = bool(existing_meta[dst_key].get("hadOriginal", False))
    elif dst_file.is_file():
        shutil.copy2(dst_file, bak_file)
        had_original = True

    dst_file.parent.mkdir(parents=True, exist_ok=True)
    raw = src_file.read_text(encoding="utf-8")
    rendered = render_ecosystem_content(raw, profile=profile, accent_hex=accent_hex)
    dst_file.write_text(rendered, encoding="utf-8")
    return {
        "target": dst_key,
        "backup": str(bak_file) if had_original else None,
        "hadOriginal": had_original,
    }


def ecosystem_status() -> dict[str, Any]:
    state = load_ecosystem_state().get("apps", {})
    result: dict[str, Any] = {}
    for app_id, app in SUPPORTED_ECOSYSTEM_APPS.items():
        detected = bool(app["detect"]())
        installed = bool(app["check"]())
        app_state = state.get(app_id, {})
        files_meta = app_state.get("files", [])
        has_backup = any(
            bool(f.get("backup") and Path(f["backup"]).is_file())
            for f in files_meta
            if isinstance(f, dict)
        ) or bool(app_id in state and installed)
        result[app_id] = {
            "name": app["name"],
            "description": app["description"],
            "detected": detected,
            "installed": installed,
            "hasBackup": has_backup,
            "syncedProfile": app_state.get("profile"),
            "syncedAccent": app_state.get("accent"),
        }
    return result


def ecosystem_apply(
    app_names: list[str] | None = None,
    dry_run: bool = False,
    profile: str | None = None,
    accent_hex: str | None = None,
) -> dict[str, Any]:
    targets = app_names if app_names and "all" not in app_names else list(SUPPORTED_ECOSYSTEM_APPS.keys())
    applied: list[str] = []
    skipped: list[str] = []
    errors: dict[str, str] = {}

    status = get_current_status()
    active_profile = (profile or status.get("profile") or "graphite").lower()
    if active_profile not in ("graphite", "obsidian"):
        active_profile = "graphite"
    is_obsidian = active_profile == "obsidian"
    active_accent = accent_hex or status.get("accentHex") or get_active_accent_hex()

    state = load_ecosystem_state()
    apps_state: dict[str, Any] = state.setdefault("apps", {})

    primary_pairs = {
        "zed": ("noxforge.json", "noxforge_obsidian.json"),
        "btop": ("noxforge.theme", "noxforge_obsidian.theme"),
        "helix": ("noxforge.toml", "noxforge_obsidian.toml"),
        "neovim": ("noxforge.lua", "noxforge_obsidian.lua"),
        "ghostty": ("noxforge", "noxforge-obsidian"),
        "kitty": ("noxforge.conf", "noxforge-obsidian.conf"),
        "alacritty": ("noxforge.toml", "noxforge-obsidian.toml"),
        "foot": ("noxforge.ini", "noxforge-obsidian.ini"),
    }

    for app_id in targets:
        if app_id not in SUPPORTED_ECOSYSTEM_APPS:
            errors[app_id] = f"Unknown ecosystem application: {app_id}"
            continue
        app = SUPPORTED_ECOSYSTEM_APPS[app_id]
        src = find_asset(app["source_subpath"])
        if not src or not src.exists():
            errors[app_id] = f"Source assets not found: {app['source_subpath']}"
            continue
        target_dir = app["target_dir"]()
        if not target_dir:
            skipped.append(app_id)
            continue
        try:
            deployed_files: list[dict[str, Any]] = []
            existing_list = apps_state.get(app_id, {}).get("files", [])
            existing_meta = {
                str(f["target"]): f
                for f in existing_list
                if isinstance(f, dict) and "target" in f
            }
            if not dry_run:
                target_dir.mkdir(parents=True, exist_ok=True)
                if app_id == "starship":
                    deployed_files.append(
                        _deploy_tracked_file(
                            src / "starship.toml",
                            target_dir / "starship.toml",
                            active_profile,
                            active_accent,
                            existing_meta,
                        )
                    )
                elif app_id == "fastfetch":
                    deployed_files.append(
                        _deploy_tracked_file(
                            src / "noxforge.jsonc",
                            target_dir / "config.jsonc",
                            active_profile,
                            active_accent,
                            existing_meta,
                        )
                    )
                elif app_id == "firefox":
                    src_css = src / ("userChrome_obsidian.css" if is_obsidian and (src / "userChrome_obsidian.css").is_file() else "userChrome.css")
                    deployed_files.append(
                        _deploy_tracked_file(
                            src_css,
                            target_dir / "userChrome.css",
                            active_profile,
                            active_accent,
                            existing_meta,
                        )
                    )
                elif app_id == "discord":
                    for item in sorted(src.iterdir()):
                        if item.is_file():
                            item_src = item
                            if item.name == "noxforge.theme.css" and is_obsidian and (src / "noxforge_obsidian.theme.css").is_file():
                                item_src = src / "noxforge_obsidian.theme.css"
                            deployed_files.append(
                                _deploy_tracked_file(
                                    item_src,
                                    target_dir / item.name,
                                    active_profile,
                                    active_accent,
                                    existing_meta,
                                )
                            )
                elif src.is_dir():
                    std_name, obs_name = primary_pairs.get(app_id, ("", ""))
                    for item in sorted(src.iterdir()):
                        if item.is_file():
                            item_src = item
                            if std_name and item.name == std_name and is_obsidian and (src / obs_name).is_file():
                                item_src = src / obs_name
                            deployed_files.append(
                                _deploy_tracked_file(
                                    item_src,
                                    target_dir / item.name,
                                    active_profile,
                                    active_accent,
                                    existing_meta,
                                )
                            )
                        elif item.is_dir():
                            sub_dst = target_dir / item.name
                            sub_dst.mkdir(parents=True, exist_ok=True)
                            for sub_item in sorted(item.iterdir()):
                                if sub_item.is_file():
                                    deployed_files.append(
                                        _deploy_tracked_file(
                                            sub_item,
                                            sub_dst / sub_item.name,
                                            active_profile,
                                            active_accent,
                                            existing_meta,
                                        )
                                    )
                elif src.is_file():
                    deployed_files.append(
                        _deploy_tracked_file(
                            src,
                            target_dir / src.name,
                            active_profile,
                            active_accent,
                            existing_meta,
                        )
                    )

                apps_state[app_id] = {
                    "profile": active_profile,
                    "accent": active_accent,
                    "files": deployed_files,
                }
            applied.append(app_id)
        except Exception as err:
            errors[app_id] = str(err)

    if not dry_run and applied:
        save_ecosystem_state(state)

    return {
        "status": "applied" if not dry_run else "dry-run",
        "profile": active_profile,
        "accent": active_accent,
        "applied": applied,
        "skipped": skipped,
        "errors": errors,
    }


def ecosystem_restore(app_names: list[str] | None = None, dry_run: bool = False) -> dict[str, Any]:
    """Restore .noxforge.bak backups or remove NoxForge-deployed files for ecosystem apps."""
    state = load_ecosystem_state()
    apps_state: dict[str, Any] = state.get("apps", {})
    targets = app_names if app_names and "all" not in app_names else list(apps_state.keys() or SUPPORTED_ECOSYSTEM_APPS.keys())

    restored: list[str] = []
    skipped: list[str] = []
    errors: dict[str, str] = {}

    for app_id in targets:
        if app_id not in SUPPORTED_ECOSYSTEM_APPS:
            errors[app_id] = f"Unknown ecosystem application: {app_id}"
            continue
        app_entry = apps_state.get(app_id)
        target_dir = SUPPORTED_ECOSYSTEM_APPS[app_id]["target_dir"]()
        files_meta: list[dict[str, Any]] = app_entry.get("files", []) if isinstance(app_entry, dict) else []

        # Fallback discovery of .noxforge.bak files in target_dir if state entry is absent
        if not files_meta and target_dir and target_dir.is_dir():
            for bak in sorted(target_dir.glob(f"*{BACKUP_SUFFIX}")):
                orig = Path(str(bak)[: -len(BACKUP_SUFFIX)])
                files_meta.append({"target": str(orig), "backup": str(bak), "hadOriginal": True})

        if not files_meta and app_id not in apps_state:
            skipped.append(app_id)
            continue

        try:
            if not dry_run:
                for fmeta in files_meta:
                    target_path = Path(fmeta["target"])
                    backup_str = fmeta.get("backup")
                    backup_path = Path(backup_str) if backup_str else Path(str(target_path) + BACKUP_SUFFIX)
                    if backup_path.is_file():
                        shutil.copy2(backup_path, target_path)
                        backup_path.unlink()
                    elif not fmeta.get("hadOriginal", False) and target_path.is_file():
                        target_path.unlink()
                apps_state.pop(app_id, None)
            restored.append(app_id)
        except Exception as err:
            errors[app_id] = str(err)

    if not dry_run:
        save_ecosystem_state(state)

    return {
        "status": "restored" if not dry_run else "dry-run",
        "restored": restored,
        "skipped": skipped,
        "errors": errors,
    }


def sync_tracked_ecosystem(
    profile: str | None = None,
    accent_hex: str | None = None,
    dry_run: bool = False,
) -> list[str]:
    """Automatically synchronize all previously deployed ecosystem apps."""
    state = load_ecosystem_state()
    tracked_apps = list(state.get("apps", {}).keys())
    if not tracked_apps:
        return []
    res = ecosystem_apply(app_names=tracked_apps, dry_run=dry_run, profile=profile, accent_hex=accent_hex)
    return list(res.get("applied", []))


