def read_config(paths: list[Path]) -> configparser.ConfigParser:
    """Read existing INI files in increasing precedence order."""
    parser = configparser.ConfigParser(interpolation=None, strict=False)
    parser.optionxform = str
    for path in paths:
        try:
            with path.open(encoding="utf-8") as handle:
                parser.read_file(handle)
        except (configparser.Error, OSError):
            continue
    return parser


def plm_config_paths(root: Path) -> list[Path]:
    paths = [root / "usr/lib/plasmalogin/defaults.conf", root / "etc/plasmalogin.conf"]
    paths.extend(sorted((root / "etc/plasmalogin.conf.d").glob("*.conf")))
    return paths


def sddm_config_paths(root: Path) -> list[Path]:
    paths = sorted((root / "usr/lib/sddm/sddm.conf.d").glob("*.conf"))
    paths.append(root / "etc/sddm.conf")
    paths.extend(sorted((root / "etc/sddm.conf.d").glob("*.conf")))
    return paths


def configured_plm_wallpaper(root: Path) -> str | None:
    parser = read_config(plm_config_paths(root))
    section = "Greeter][Wallpaper][org.kde.image][General"
    value = parser.get(section, "Image", fallback="").strip()
    return value or None


def configured_sddm_theme(root: Path) -> str | None:
    parser = read_config(sddm_config_paths(root))
    value = parser.get("Theme", "Current", fallback="").strip()
    return value or None


def display_manager_state(root: Path) -> tuple[str, str]:
    if root != Path("/"):
        return "not-detected", "not-applicable"
    active: list[str] = []
    unknown = False
    for manager, service in (("plasmalogin", "plasmalogin.service"), ("sddm", "sddm.service")):
        try:
            result = subprocess.run(
                ["systemctl", "is-active", service],
                check=False,
                capture_output=True,
                text=True,
                timeout=2,
            )
        except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
            unknown = True
            continue
        if result.returncode not in (0, 3, 4):
            unknown = True
        if result.returncode == 0 and result.stdout.strip() == "active":
            active.append(manager)
    if len(active) == 1:
        return active[0], "active"
    if len(active) > 1:
        return "other", "active"
    display_manager = Path("/etc/systemd/system/display-manager.service")
    try:
        target = display_manager.resolve(strict=True).name
    except OSError:
        target = ""
    if target == "plasmalogin.service":
        return "plasmalogin", "unknown" if unknown else "inactive"
    if target == "sddm.service":
        return "sddm", "unknown" if unknown else "inactive"
    if target:
        return "other", "unknown" if unknown else "inactive"
    return "not-detected", "unknown" if unknown else "inactive"


def login_surface_report(root: Path, components: dict[str, dict[str, Any]]) -> dict[str, Any]:
    manager, service_state = display_manager_state(root)
    system_root = root if root != Path("/") else Path("/")
    quiet_paths = [
        data_root / f"wallpapers/{PLM_WALLPAPER_ID}/metadata.json"
        for data_root in data_roots(root)
    ]
    quiet_available = any(scoped_file(path, root) for path in quiet_paths)
    sddm_available = components.get("sddm", {}).get("found", False)

    integration = "none"
    asset: str | None = None
    available = False
    selected = False
    if manager == "plasmalogin":
        integration = "wallpaper"
        asset = PLM_WALLPAPER_ID
        available = quiet_available
        configured = configured_plm_wallpaper(system_root)
        selected = bool(configured and re.search(r"/wallpapers/NoxForge-Quiet(?:/|$)", configured))
    elif manager == "sddm":
        integration = "custom-theme"
        asset = "NoxForge"
        available = bool(sddm_available)
        selected = configured_sddm_theme(system_root) == "NoxForge"

    if service_state == "not-applicable":
        status = "not-applicable"
    elif manager in {"other", "not-detected"}:
        status = "not-integrated"
    elif not available:
        status = "unavailable"
    elif selected:
        status = "selected"
    else:
        status = "available"
    return {
        "manager": manager,
        "serviceState": service_state,
        "integration": integration,
        "asset": asset,
        "available": available,
        "selected": selected,
        "status": status,
    }


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Inspect NoxForge without changing settings or files."
    )
    parser.add_argument(
        "--root",
        type=Path,
        default=Path("/"),
        help="inspect an absolute staged or system root (default: /)",
    )
    parser.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    parser.add_argument(
        "--remediation-plan",
        action="store_true",
        help="emit actionable, non-destructive remediation shell commands",
    )
    return parser.parse_args()


def data_roots(root: Path) -> list[Path]:
    if root != Path("/"):
        if any((root / name).is_dir() for name in ("noxforge", "plasma", "color-schemes", "icons", "wallpapers", "sounds", "aurorae", "kwin")):
            return [root]
        return [root / "usr/local/share", root / "usr/share"]
    roots: list[Path] = []
    configured = os.environ.get("XDG_DATA_HOME")
    if configured:
        roots.append(Path(configured))
    else:
        roots.append(Path.home() / ".local/share")
    roots.extend(Path(value) for value in os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":") if value and Path(value).is_absolute())
    return list(dict.fromkeys(roots))


def component_path(data_root: Path, definition: tuple[str, str, str]) -> Path:
    category, directory, marker = definition
    path = data_root / category
    if directory:
        path /= directory
    return path / marker


def metadata_version(path: Path) -> str | None:
    if path.name == "metadata.json":
        try:
            value = json.loads(path.read_text(encoding="utf-8"))["KPlugin"]["Version"]
        except (KeyError, TypeError, json.JSONDecodeError, OSError):
            return None
        return value if isinstance(value, str) and SEMVER.fullmatch(value) else None
    if path.name == "metadata.desktop":
        parser = configparser.ConfigParser(interpolation=None)
        try:
            parser.read(path, encoding="utf-8")
        except (configparser.Error, OSError):
            return None
        for section, key in (
            ("Desktop Entry", "X-KDE-PluginInfo-Version"),
            ("SddmGreeterTheme", "Version"),
        ):
            if parser.has_option(section, key):
                value = parser.get(section, key)
                return value if SEMVER.fullmatch(value) else None
    return None


def scoped_file(path: Path, root: Path = Path("/")) -> bool:
    """Reject missing files, broken links and links outside an isolated root."""
    try:
        return path.is_file() and (root == Path("/") or path.resolve().is_relative_to(root.resolve()))
    except (OSError, RuntimeError):
        return False


def expected_version(root: Path) -> str | None:
    candidates = [data_root / "noxforge/VERSION" for data_root in data_roots(root)]
    for path in candidates:
        if not scoped_file(path, root):
            continue
        try:
            value = path.read_text(encoding="utf-8").strip()
        except OSError:
            continue
        if SEMVER.fullmatch(value):
            return value
    return None


def package_version(root: Path) -> str | None:
    # rpm --root may create a database or lock file in an otherwise read-only
    # staging tree. Component metadata remains authoritative for --root checks.
    if root != Path("/"):
        return None
    command = ["rpm"]
    command.extend(("-q", "--qf", "%{VERSION}-%{RELEASE}", "noxforge"))
    try:
        result = subprocess.run(
            command,
            check=False,
            capture_output=True,
            text=True,
            timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    return result.stdout.strip() if result.returncode == 0 else None


def qt_plugin_paths(root: Path) -> list[Path]:
    candidates: list[Path] = []
    for libdir in ("lib64", "lib"):
        candidate = root / f"usr/{libdir}/qt6/plugins/styles/libnoxforge6.so"
        if scoped_file(candidate, root):
            candidates.append(candidate)
    return candidates


def read_active_components() -> dict[str, str]:
    config_root = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    reader = shutil.which("kreadconfig6")
    active: dict[str, str] = {}
    for label, (filename, section, key) in ACTIVE_CONFIG.items():
        if reader:
            try:
                result = subprocess.run(
                    [reader, "--file", filename, "--group", section, "--key", key],
                    check=False,
                    capture_output=True,
                    text=True,
                    timeout=2,
                )
            except (OSError, subprocess.TimeoutExpired):
                result = None
            if result is not None and result.returncode == 0 and result.stdout.strip():
                active[label] = result.stdout.strip()
                continue
        parser = configparser.ConfigParser(interpolation=None)
        try:
            parser.read(config_root / filename, encoding="utf-8")
        except (configparser.Error, OSError):
            continue
        if parser.has_option(section, key):
            active[label] = parser.get(section, key)
    return active


def current_activity() -> str | None:
    command = shutil.which("qdbus-qt6")
    if not command:
        return None
    try:
        result = subprocess.run(
            [
                command,
                "org.kde.ActivityManager",
                "/ActivityManager/Activities",
                "org.kde.ActivityManager.Activities.CurrentActivity",
            ],
            check=False,
            capture_output=True,
            text=True,
            timeout=2,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    value = result.stdout.strip()
    return value if result.returncode == 0 and value else None


def detect_wallpaper() -> str:
    config_root = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    path = config_root / "plasma-org.kde.plasma.desktop-appletsrc"
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return "not-detected"
    containments: dict[str, dict[str, str]] = {}
    current_id: str | None = None
    current_kind: str | None = None
    for line in lines:
        section = re.fullmatch(r"\[Containments\]\[(\d+)\](.*)", line)
        if section:
            current_id = section.group(1)
            suffix = section.group(2)
            current_kind = "base" if not suffix else (
                "wallpaper" if suffix.startswith("[Wallpaper]") else "other"
            )
            containments.setdefault(current_id, {})
            continue
        if current_id is None or current_kind not in ("base", "wallpaper") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        if current_kind == "base" and key in (
            "activityId",
            "lastScreen",
            "plugin",
            "wallpaperplugin",
        ):
            containments[current_id][key] = value
        elif current_kind == "wallpaper" and key == "Image":
            containments[current_id]["Image"] = value

    activity = current_activity()
    active: list[dict[str, str]] = []
    unresolved_activity = False
    for containment in containments.values():
        if containment.get("plugin") == "org.kde.panel":
            continue
        if not containment.get("wallpaperplugin") and "Image" not in containment:
            continue
        try:
            visible_screen = int(containment.get("lastScreen", "-1")) >= 0
        except ValueError:
            visible_screen = False
        if not visible_screen:
            continue
        activity_id = containment.get("activityId", "")
        if activity_id and activity is None:
            unresolved_activity = True
            continue
        if not activity_id or activity_id == activity:
            active.append(containment)
    if unresolved_activity:
        return "ambiguous"
    if not active:
        return "not-detected"
    images = [containment.get("Image", "") for containment in active]
    if any(not image for image in images):
        return "ambiguous"
    wallpaper_ids = []
    for image in images:
        match = re.search(r"/wallpapers/(NoxForge(?:-Quiet|-Ultrawide)?)/", image)
        wallpaper_ids.append(match.group(1) if match else None)
    if all(wallpaper_ids):
        return wallpaper_ids[0] if len(set(wallpaper_ids)) == 1 else "ambiguous"
    if not any(wallpaper_ids):
        return "other"
    return "ambiguous"


def data_root_provenance(root: Path, data_root: Path) -> str:
    if root != Path("/"):
        return "staged-system"
    if data_root == Path("/usr/share"):
        return "system"
    if data_root == Path("/usr/local/share"):
        return "local-system"
    return "user"


def icon_diagnostics(roots: list[Path], root: Path = Path("/")) -> dict[str, Any]:
    theme_roots = [candidate / "icons/NoxForge" for candidate in roots]
    installed = next((candidate for candidate in theme_roots if scoped_file(candidate / "index.theme", root)), None)
    if installed is None:
        return {
            "inheritance": [],
            "manifestPresent": False,
            "requiredCount": 0,
            "unresolved": [],
            "status": "theme-missing",
        }
    parser = configparser.ConfigParser(interpolation=None)
    try:
        parser.read(installed / "index.theme", encoding="utf-8")
        inheritance = [
            item.strip()
            for item in parser.get("Icon Theme", "Inherits", fallback="").split(",")
            if item.strip()
        ]
    except configparser.Error:
        inheritance = []
    coverage_path = installed / "coverage.json"
    try:
        if not scoped_file(coverage_path, root):
            raise OSError("coverage outside diagnostic root or missing")
        fixture = json.loads(coverage_path.read_text(encoding="utf-8"))["runtimeFixture"]
    except (KeyError, TypeError, json.JSONDecodeError, OSError):
        return {
            "inheritance": inheritance,
            "manifestPresent": False,
            "requiredCount": 0,
            "unresolved": [],
            "status": "manifest-unavailable",
        }
    unresolved = [
        relative
        for relative in fixture
        if not any(
            scoped_file(installed / directory / relative, root)
            for directory in ("scalable", "16x16", "22x22")
        )
    ]
    return {
        "inheritance": inheritance,
        "manifestPresent": True,
        "requiredCount": len(fixture),
        "unresolved": sorted(unresolved),
        "status": "ok" if not unresolved else "unresolved",
    }


def parse_kscreen_doctor(output: str) -> list[dict[str, Any]]:
    outputs: list[dict[str, Any]] = []
    current: dict[str, Any] | None = None
    for raw_line in output.splitlines():
        line = ANSI_ESCAPE.sub("", raw_line).strip()
        match = re.match(r"Output:\s+\d+\s+(\S+)", line)
        if match:
            current = {
                "name": match.group(1),
                "enabled": False,
                "connected": False,
                "scale": None,
            }
            outputs.append(current)
            continue
        if current is None:
            continue
        if line == "enabled":
            current["enabled"] = True
        elif line == "connected":
            current["connected"] = True
        elif line.startswith("Scale:"):
            try:
                current["scale"] = float(line.split(":", 1)[1].strip())
            except ValueError:
                current["scale"] = None
    return [item for item in outputs if item["scale"] is not None]


def output_scales(root: Path) -> dict[str, Any]:
    if root != Path("/"):
        return {"status": "not-applicable-staged-root", "source": None, "outputs": []}
    command = shutil.which("kscreen-doctor")
    if not command:
        return {"status": "unavailable", "source": None, "outputs": []}
    try:
        result = subprocess.run(
            [command, "-o"],
            check=False,
            capture_output=True,
            text=True,
            timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return {"status": "unavailable", "source": None, "outputs": []}
    outputs = parse_kscreen_doctor(result.stdout) if result.returncode == 0 else []
    return {
        "status": "ok" if outputs else "unavailable",
        "source": "KScreen/KWin runtime" if outputs else None,
        "outputs": outputs,
    }


def edition_manifest(roots: list[Path], root: Path = Path("/")) -> dict[str, Any] | None:
    for data_root in roots:
        for candidate in (data_root / "noxforge/manifest.json", data_root / "noxforge/edition.json"):
            if not scoped_file(candidate, root):
                continue
            try:
                value = json.loads(candidate.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                continue
            if isinstance(value, dict):
                return value
    return None


def edition_report(
    roots: list[Path],
    components: dict[str, dict[str, Any]],
    plugins: list[Path],
    mixed: bool,
    active: dict[str, str],
    root: Path = Path("/"),
) -> dict[str, Any]:
    found = {name for name, state in components.items() if state["found"]}
    portable_missing = sorted(set(PORTABLE_REQUIRED) - found)
    has_portable_marker = edition_manifest(roots, root) is not None or any(
        scoped_file(candidate / "noxforge/.owned-files", root) for candidate in roots
    )
    user_copies = {
        name
        for name, state in components.items()
        if state["found"] and "user" in state["provenance"]
    }
    system_copies = {
        name
        for name, state in components.items()
        if state["found"] and any(value in state["provenance"] for value in ("system", "local-system", "staged-system"))
    }
    shadowed = sorted(user_copies & system_copies)
    native = bool(plugins)
    system_marker = any(scoped_file(candidate / "noxforge/release-manifest.json", root) for candidate in roots)
    if native or system_marker or has_portable_marker:
        required = set(PORTABLE_REQUIRED)
    elif "global-theme" in found:
        required = set(STORE_REQUIRED)
    else:
        required = set()
    missing = sorted(required - found)
    if native or system_marker:
        kind = "complete-system"
        if not native:
            missing.append("qt-style")
    elif has_portable_marker:
        kind = "portable"
    elif found:
        kind = "component"
    else:
        kind = "absent"
        missing = sorted(COMPONENTS) + ["qt-style"]
    status = "incomplete" if missing else "ok"
    if kind == "absent":
        status = "absent"
    base_kind = kind
    if mixed or (active.get("qtStyle") == "NoxForge" and not native):
        kind = status = "mixed"
        if active.get("qtStyle") == "NoxForge" and not native:
            missing.append("native-qt-style")
    capabilities = ["user-local-components"] if found else []
    if base_kind in {"portable", "complete-system"}:
        capabilities.extend(["installer", "uninstaller", "doctor"])
    if native:
        capabilities.append("native-qt-style")
    if components.get("sddm", {}).get("found"):
        capabilities.append("sddm-theme")
    return {
        "kind": kind,
        "status": status,
        "capabilities": sorted(set(capabilities)),
        "missingMandatory": sorted(set(missing)),
        "shadowed": shadowed,
        "portableMarker": has_portable_marker,
        "storeDependencies": sorted(set(missing)) if kind == "component" else [],
        "wallpaperVariants": {
            name: any(scoped_file(candidate / f"wallpapers/{name}/metadata.json", root) for candidate in roots)
            for name in ("NoxForge", "NoxForge-Quiet", "NoxForge-Ultrawide")
        },
        "colorSchemeVariants": {
            name: any(scoped_file(candidate / f"color-schemes/{name}.colors", root) for candidate in roots)
            for name in ("NoxForgeDark", "NoxForgeObsidian")
        },
        "terminalThemes": {
            name: any(scoped_file(candidate / f"konsole/{name}.colorscheme", root) for candidate in roots)
            for name in ("NoxForge", "NoxForgeObsidian")
        },
    }


def content_digest(marker: Path, *, single_file: bool = False) -> str | None:
    """Compare complete component payloads, without following directory symlinks."""
    base = marker.parent
    digest = hashlib.sha256()
    try:
        paths = [marker] if single_file else sorted(base.rglob("*"))
        for path in paths:
            if path.is_symlink():
                digest.update(path.relative_to(base).as_posix().encode())
                digest.update(b"link:" + os.readlink(path).encode())
            elif path.is_file():
                digest.update(path.relative_to(base).as_posix().encode() + b"\0")
                digest.update(hashlib.sha256(path.read_bytes()).digest())
    except OSError:
        return None
    return digest.hexdigest()


def display_path(path: Path, root: Path) -> str:
    if root == Path("/"):
        user_root = data_roots(root)[0]
        if path.is_relative_to(user_root):
            return "$XDG_DATA_HOME/" + path.relative_to(user_root).as_posix()
    return str(path)


def build_report(root: Path) -> dict[str, Any]:
    roots = data_roots(root)
    components: dict[str, dict[str, Any]] = {}
    versions: set[str] = set()
    for name, definition in COMPONENTS.items():
        matches = [
            component_path(candidate, definition)
            for candidate in roots
            if scoped_file(component_path(candidate, definition), root)
        ]
        discovered_versions = sorted(
            {
                version
                for match in matches
                if (version := metadata_version(match)) is not None
            }
        )
        versions.update(discovered_versions)
        digests = [content_digest(match, single_file=name == "color-scheme") for match in matches]
        duplicate = "none"
        if len(matches) > 1:
            duplicate = "unknown" if None in digests else ("identical" if len(set(digests)) == 1 else "conflict")
        components[name] = {
            "paths": [display_path(match, root) for match in matches],
            "effectivePath": display_path(matches[0], root) if matches else None,
            "shadowedPaths": [display_path(match, root) for match in matches[1:]],
            "duplicateStatus": duplicate,
            "metadataStatus": "known" if matches and all(metadata_version(match) for match in matches) else "unknown",
            "copyVersions": [metadata_version(match) for match in matches],
            "found": bool(matches),
            "copies": len(matches),
            "versions": discovered_versions,
            "provenance": sorted(
                {
                    data_root_provenance(root, candidate)
                    for candidate in roots
                    if component_path(candidate, definition) in matches
                }
            ),
        }

    plugins = qt_plugin_paths(root)
    components["qt-style"] = {
        "paths": [display_path(path, root) for path in plugins],
        "effectivePath": None,
        "shadowedPaths": [],
        "duplicateStatus": "not-applicable",
        "metadataStatus": "unknown",
        "copyVersions": [None for path in plugins],
        "found": bool(plugins),
        "copies": len(plugins),
        "versions": [],
        "provenance": ["system" if root == Path("/") else "staged-system"] if plugins else [],
    }

    icons = icon_diagnostics(roots, root)

    expected = expected_version(root)
    mixed = len(versions) > 1 or (
        expected is not None and any(version != expected for version in versions)
    )
    active: dict[str, str] = {}
    if root == Path("/"):
        active = read_active_components()
        active["iconInheritance"] = ",".join(icons["inheritance"]) or "none"
        active["wallpaper"] = detect_wallpaper()
    edition = edition_report(roots, components, plugins, mixed, active, root)
    issues: list[dict[str, str]] = []
    for name, state in components.items():
        duplicate = state["duplicateStatus"]
        if duplicate != "none" and duplicate != "not-applicable":
            issues.append({"code": "duplicate-" + duplicate, "component": name,
                           "severity": "error" if duplicate == "conflict" else "warning",
                           "message": f"{name}: {duplicate} copies; first discovered path has precedence. Review shadowed paths manually."})
        if state["found"] and state["metadataStatus"] == "unknown":
            issues.append({"code": "metadata-unknown", "component": name, "severity": "info",
                           "message": f"{name}: component version metadata is unavailable."})
    if mixed:
        issues.append({"code": "mixed-versions", "component": "installation", "severity": "error",
                       "message": "Installed component versions disagree with each other or the installed VERSION marker."})
    if icons["status"] == "unresolved":
        edition["missingMandatory"] = sorted(set(edition["missingMandatory"]) | {"critical-icons"})
    missing = edition["missingMandatory"]
    for name in missing:
        issues.append({"code": "missing-required", "component": name, "severity": "error",
                       "message": f"Required component is missing: {name}."})
    complete = not any(issue["severity"] == "error" for issue in issues)
    if any(state["duplicateStatus"] == "conflict" for state in components.values()):
        edition["kind"] = edition["status"] = "mixed"
    elif not complete and edition["status"] == "ok":
        edition["status"] = "incomplete"
    if edition["kind"] == "mixed":
        next_action = "Review mixed versions and effective/shadowed paths; manually reinstall matching components. If the active native style is missing, install it or explicitly select an available style."
    elif "critical-icons" in missing:
        next_action = "Reinstall the NoxForge icon package; required core icons are unresolved."
    elif missing and edition["kind"] == "portable":
        next_action = "Reinstall the portable bundle with its installer, then rerun noxforge-doctor."
    elif missing and edition["kind"] == "complete-system":
        next_action = "Reinstall the complete-system package using your distribution package manager, then rerun noxforge-doctor."
    elif missing and edition["kind"] == "component":
        next_action = "Install or reinstall the listed required Store components, then rerun noxforge-doctor."
    elif missing:
        next_action = "Install your chosen Store components, portable bundle, or complete-system package, then rerun noxforge-doctor."
    else:
        next_action = "Installed edition is valid. Select NoxForge explicitly in System Settings if desired."

    report: dict[str, Any] = {
        "schemaVersion": 4,
        "issues": issues,
        "status": "ok" if complete else "incomplete",
        "packageVersion": package_version(root),
        "expectedVersion": expected,
        "componentVersions": sorted(versions),
        "mixedVersions": mixed,
        "missing": missing,
        "components": components,
        "criticalIcons": icons,
        "edition": edition,
        "loginSurface": login_surface_report(root, components),
        "nextAction": next_action,
        "session": {
            "type": os.environ.get("XDG_SESSION_TYPE", "unknown") if root == Path("/") else "not-applicable",
            "kde": os.environ.get("KDE_FULL_SESSION", "unknown") if root == Path("/") else "not-applicable",
            "wayland": ("present" if os.environ.get("WAYLAND_DISPLAY") else "absent") if root == Path("/") else "not-applicable",
            "displayScales": output_scales(root),
            "kernel": platform.release() if root == Path("/") else "not-applicable",
        },
    }
    report["active"] = active
    return report


def print_human(report: dict[str, Any]) -> None:
    print(f"NoxForge doctor: {report['status']}")
    edition = report.get("edition", {})
    print(f"Edition: {edition.get('kind', 'unknown')} ({edition.get('status', 'unknown')})")
    login = report.get("loginSurface", {})
    print(
        "Login surface: "
        f"{login.get('manager', 'not-detected')} "
        f"({login.get('serviceState', 'unknown')}, {login.get('status', 'not-integrated')})"
    )
    missing = edition.get("missingMandatory", [])
    if missing:
        print(f"Edition missing: {', '.join(missing)}")
    print(f"Package: {report['packageVersion'] or 'not registered'}")
    print(f"Expected version: {report['expectedVersion'] or 'unknown'}")
    for name, state in report["components"].items():
        label = "found" if state["found"] else "missing"
        suffix = f" ({', '.join(state['versions'])})" if state["versions"] else ""
        print(f"  {name}: {label}{suffix}")
        for index, path in enumerate(state["paths"]):
            role = "effective" if index == 0 and name != "qt-style" else "discovered" if name == "qt-style" else "shadowed"
            print(f"    {role}: {path}")
    for issue in report["issues"]:
        print(f"  [{issue['severity']}: {issue['code']}] {issue['message']}")
    if report["active"]:
        print("Active settings (read-only):")
        for name, value in sorted(report["active"].items()):
            print(f"  {name}: {value}")
    session = report["session"]
    print(
        "Session: "
        f"{session['type']}, KDE={session['kde']}, Wayland={session['wayland']}, "
        f"scale-source={session['displayScales']['source'] or session['displayScales']['status']}, "
        f"kernel={session['kernel']}"
    )
    for output in session["displayScales"]["outputs"]:
        print(f"  output {output['name']}: scale={output['scale']:g}")
    print(f"Next action: {report['nextAction']}")


def remediation_plan(report: dict[str, Any]) -> str:
    lines = [
        "#!/usr/bin/env bash",
        "# NoxForge non-destructive remediation plan",
        "set -euo pipefail",
        "",
    ]
    edition = report.get("edition", {})
    kind = edition.get("kind", "unknown")
    missing = edition.get("missingMandatory", [])
    shadowed = edition.get("shadowed", [])
    if not missing and not shadowed and report.get("status") == "ok":
        lines.append("# Installation is clean and complete. No remediation required.")
        return "\n".join(lines) + "\n"
    if shadowed:
        lines.append("# Shadowed component copies detected in user data:")
        for name in shadowed:
            lines.append(f"# Note: user copy of '{name}' takes precedence over system package.")
        lines.append("")
    if kind == "complete-system":
        lines.append("# Recommended system package remediation:")
        lines.append("if command -v dnf &>/dev/null; then")
        lines.append("    sudo dnf reinstall noxforge")
        lines.append("elif command -v pacman &>/dev/null; then")
        lines.append("    echo 'Arch Linux: rebuild and reinstall noxforge from packaging/arch/PKGBUILD'")
        lines.append("fi")
    elif kind == "portable":
        lines.append("# Recommended portable package remediation:")
        lines.append("./scripts/install.sh --user")
    elif kind == "component":
        lines.append("# Recommended Store component remediation:")
        for comp in missing:
            lines.append(f"# Reinstall KDE Store component: {comp}")
    else:
        lines.append("# Recommended installation:")
        lines.append("# Complete system: sudo dnf install noxforge")
        lines.append("# Portable: ./scripts/install.sh --user")
    return "\n".join(lines) + "\n"


def main() -> int:
    arguments = parse_args()
    root = arguments.root
    if not root.is_absolute():
        print("--root must be an absolute path", file=sys.stderr)
        return 2
    report = build_report(root)
    if arguments.remediation_plan:
        print(remediation_plan(report), end="")
        return 0 if report["status"] == "ok" else 1
    if arguments.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print_human(report)
    return 0 if report["status"] == "ok" else 1


if __name__ == "__main__":
    raise SystemExit(main())
